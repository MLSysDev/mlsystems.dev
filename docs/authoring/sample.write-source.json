        "source": "export default function ParamCounter() {\n  const layers = [784, 128, 10];\n  const params = layers.slice(1).reduce((sum, d, i) => sum + layers[i] * d + d, 0);\n  return (\n    <div style={{ fontFamily: 'monospace', padding: 16, border: '1px solid currentColor' }}>\n      MLP {layers.join(' → ')} has {params.toLocaleString()} parameters\n    </div>\n  );\n}\n"
