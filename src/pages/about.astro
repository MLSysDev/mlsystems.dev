---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IconLinkCard from '@/components/IconLinkCard.astro';
import { SITE } from '@/lib/site';

const GITHUB_URL = 'https://github.com/HumbleBee14';
const ADMIN_EMAIL = SITE.pitchEmail;

const links = [
  {
    label: 'GitHub',
    action: 'HumbleBee14',
    href: GITHUB_URL,
    icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'Email',
    action: ADMIN_EMAIL,
    href: `mailto:${ADMIN_EMAIL}`,
    icon: 'M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67ZM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z',
  },
];
---

<BaseLayout
  title="About"
  description="Why ML Systems exists — an open, community-written archive of articles, primers, and tools on machine learning systems, from inference and training to LLM architecture."
  image="/og/page/about.png"
>
  <div class="container blog-shell">
    <div class="about-head">
      <div class="eyebrow page-eyebrow">About</div>
      <h1 class="blog-h1">
        Hi, I'm Humble Bee.<span class="about-cursor">_</span>
        <svg
          class="about-bee"
          viewBox="0 0 64 64"
          width="56"
          height="56"
          aria-hidden="true"
          fill="none"
        >
          <g
            class="about-bee-wings"
            stroke="currentColor"
            stroke-width="1.6"
            fill="rgba(255,255,255,0.08)"
          >
            <ellipse class="about-bee-wing about-bee-wing-l" cx="22" cy="22" rx="9" ry="6"
            ></ellipse>
            <ellipse class="about-bee-wing about-bee-wing-r" cx="42" cy="22" rx="9" ry="6"
            ></ellipse>
          </g>
          <g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="32" cy="38" rx="14" ry="11" fill="var(--accent)" stroke="none"></ellipse>
            <path d="M22 32h20M22 38h20M22 44h20" stroke="#18171a" stroke-width="2"></path>
            <circle cx="27" cy="36" r="1.6" fill="#18171a" stroke="none"></circle>
            <path d="M28 28c-1-2 0-5 2-5M36 28c1-2 0-5-2-5"></path>
          </g>
        </svg>
      </h1>
    </div>

    <div class="about-body">
      <p class="about-lede">
        We're humble bees, ready to cross any field for a single drop of knowledge.
        <strong>{SITE.name}</strong> is an open community of contributors — engineers, researchers, students,
        and curious learners — writing down what we figure out about modern machine learning systems and
        sharing it with the world.
      </p>

      <p>
        The goal is simple: collect honest, technically grounded writing about ML systems — the
        kernels, the schedulers, the embeddings, the deployments — without the marketing gloss.
        Anyone interested in this domain is welcome to write here, whether you've shipped systems
        for years or you just figured something out last week. If you've learned something worth
        passing on, <a href="/contribute">come write with us</a>.
      </p>

      <p>
        Everything here is © its respective author, all rights reserved. No paywalls, no popups, no
        "10x your ML career" funnels. Just notes from the workbench.
      </p>

      <div class="about-links">
        {
          links.map((c) => (
            <IconLinkCard href={c.href} icon={c.icon} label={c.label} action={c.action} />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-head {
    padding-top: 32px;
    padding-bottom: 8px;
  }
  .about-cursor {
    display: inline-block;
    color: var(--accent);
    font-weight: 300;
    animation: blink 1.1s steps(1) infinite;
    margin-left: 4px;
  }
  .about-bee {
    display: inline-block;
    vertical-align: -0.3em;
    margin-left: 12px;
    color: var(--ink);
    animation: bee-bob 2.4s ease-in-out infinite;
  }
  .about-bee-wing {
    transform-origin: center;
    animation: bee-flap 0.18s ease-in-out infinite alternate;
  }
  .about-bee-wing-r {
    animation-delay: 0.09s;
  }
  @keyframes bee-flap {
    from {
      transform: scaleY(1) scaleX(1);
      opacity: 0.55;
    }
    to {
      transform: scaleY(0.25) scaleX(1.05);
      opacity: 0.9;
    }
  }
  @keyframes bee-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }
    50% {
      transform: translateY(-6px) rotate(3deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-bee,
    .about-bee-wing {
      animation: none;
    }
  }
  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  .about-body {
    max-width: 680px;
    margin: 32px 0 80px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .about-body p {
    margin: 0 0 20px;
  }
  .about-body a {
    color: var(--accent);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .about-body a:hover {
    border-bottom-color: var(--accent);
  }
  .about-lede {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink);
  }
  .about-lede strong {
    color: var(--accent);
    font-weight: 400;
  }

  .about-links {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media (max-width: 620px) {
    .about-links {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .about-body {
      font-size: 16px;
    }
    .about-lede {
      font-size: 19px;
    }
  }
</style>
