---
import { getCollection, getEntries } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, sortPostsByDate, topicName } from '@/lib/data';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({
    params: { handle: author.id },
    props: { author },
  }));
}

interface Props {
  author: CollectionEntry<'authors'>;
}
const { author } = Astro.props;

const allRaw = await getCollection('posts', ({ data }) => !data.draft);
const matching = allRaw.filter((p) => p.data.authors.some((ref) => ref.id === author.id));
const posts = (
  await Promise.all(
    matching.map(async (p) => ({ ...p, authors: await getEntries(p.data.authors) })),
  )
).sort(sortPostsByDate);

const topicCounts = posts.reduce<Record<string, number>>((acc, p) => {
  const name = topicName(p.data.topicId);
  acc[name] = (acc[name] ?? 0) + 1;
  return acc;
}, {});
const topTopics = Object.entries(topicCounts)
  .sort(([, a], [, b]) => b - a)
  .slice(0, 3)
  .map(([t]) => t);

const initials = author.data.name
  .split(' ')
  .map((w) => w[0])
  .join('');
const canonical = `${SITE.url}/authors/${author.id}`;

const SOCIAL_FIELDS: { key: keyof typeof author.data; label: string; prefix?: string }[] = [
  { key: 'github', label: 'GitHub' },
  { key: 'twitter', label: 'Twitter' },
  { key: 'linkedin', label: 'LinkedIn' },
  { key: 'mastodon', label: 'Mastodon' },
  { key: 'bluesky', label: 'Bluesky' },
  { key: 'website', label: 'Website' },
  { key: 'email', label: 'Email', prefix: 'mailto:' },
];
const socials = SOCIAL_FIELDS.flatMap((f) => {
  const value = author.data[f.key];
  if (!value || typeof value !== 'string') return [];
  return [{ label: f.label, href: f.prefix ? `${f.prefix}${value}` : value }];
});
---

<BaseLayout
  title={`${author.data.name} — author profile`}
  description={author.data.bio ?? `Articles by ${author.data.name} on ${SITE.name}.`}
  canonical={canonical}
  image={`/og/author/${author.id}.png`}
>
  <div
    class="container author-page"
    data-pagefind-body
    data-pagefind-meta={`topic:Author, role:${author.data.role}`}
  >
    <a href="/authors" class="article-back">← All contributors</a>

    <header class="author-head">
      <div class="author-head-left">
        <div class="author-avatar-lg" aria-hidden="true">
          {
            author.data.avatar ? (
              <img src={author.data.avatar} alt="" loading="lazy" decoding="async" />
            ) : (
              initials
            )
          }
        </div>
      </div>
      <div class="author-head-right">
        <div class="eyebrow page-eyebrow">{author.data.role}</div>
        <h1 class="author-name">{author.data.name}</h1>
        <div class="author-handle">@{author.id}</div>

        {author.data.bio && <p class="author-bio">{author.data.bio}</p>}

        <div class="author-stats">
          <div>
            <strong>{posts.length}</strong>
            <span>{posts.length === 1 ? 'article' : 'articles'}</span>
          </div>
          {
            topTopics.length > 0 && (
              <div>
                <strong>{topTopics.join(' · ')}</strong>
                <span>focus</span>
              </div>
            )
          }
        </div>

        {
          socials.length > 0 && (
            <div class="author-links">
              {socials.map((s) => (
                <a
                  href={s.href}
                  target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel={s.href.startsWith('mailto:') ? undefined : 'noreferrer'}
                >
                  {s.label} →
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <section class="author-articles">
      <div class="eyebrow">
        {posts.length === 1 ? '1 article' : `${posts.length} articles`}
      </div>

      {
        posts.length === 0 ? (
          <p style="color: var(--ink-3); padding: 40px 0;">No published articles yet.</p>
        ) : (
          <div class="blog-list">
            {posts.map((p) => (
              <a href={`/blog/${p.id}`} class="blog-row" data-topic={p.data.topicId}>
                <div>
                  <h3 class="blog-row-title">{p.data.title}</h3>
                  <p class="blog-row-summary">{p.data.summary}</p>
                </div>
                <div class="blog-row-author">
                  <strong>{p.authors.map((au) => au.data.name).join(' · ')}</strong>
                  {topicName(p.data.topicId)}
                </div>
                <div class="blog-row-time">
                  {formatDate(p.data.date.toISOString())}
                  <br />
                  {p.data.readMin} min
                </div>
              </a>
            ))}
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .author-page {
    padding-top: 24px;
    padding-bottom: 80px;
  }
  .author-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 28px;
    padding: 28px 0 36px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 48px;
  }
  .author-avatar-lg {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--paper-2);
    border: 1px solid var(--line);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .author-avatar-lg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-name {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 4px 0 0;
  }
  .author-handle {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    margin-top: 6px;
  }
  .author-bio {
    font-size: 17px;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 18px 0 0;
    max-width: 640px;
  }
  .author-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 22px;
  }
  .author-stats div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .author-stats strong {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    color: var(--ink);
  }
  .author-stats span {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }
  .author-links {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .author-links a {
    color: var(--accent);
  }
  .author-articles {
    margin-top: 8px;
  }
  .author-articles .eyebrow {
    margin-bottom: 16px;
  }

  @media (max-width: 720px) {
    .author-head {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 20px 0 28px;
      margin-bottom: 32px;
    }
    .author-avatar-lg {
      width: 72px;
      height: 72px;
      font-size: 26px;
    }
    .author-name {
      font-size: 36px;
    }
    .author-stats {
      gap: 20px;
      margin-top: 18px;
    }
  }
</style>
