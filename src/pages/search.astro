---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchInline from '@/components/SearchInline.tsx';
import { TOPICS } from '@/lib/data';
---

<BaseLayout
  title="Search"
  description="Search the ML Systems archive — articles, topics, tools, and authors."
  image="/og/page/search.png"
  noindex
>
  <div class="container search-page">
    <div class="page-head">
      <div class="eyebrow page-eyebrow">Search</div>
      <h1 class="page-h1">Find anything.</h1>
      <p class="page-lede">Articles, topics, tools, and authors — one box.</p>
    </div>

    <SearchInline client:load />

    <noscript>
      <div class="search-noscript">
        <p>Interactive search needs JavaScript. Browse by topic instead:</p>
        <div class="search-topic-chips" style="margin-top: 12px;">
          {TOPICS.map((t) => <a href={`/topics/${t.id}`}>{t.name}</a>)}
        </div>
      </div>
    </noscript>
  </div>
</BaseLayout>

<style is:global>
  .search-noscript {
    padding: 32px 0;
    color: var(--ink-3);
    font-size: 14px;
  }
</style>
