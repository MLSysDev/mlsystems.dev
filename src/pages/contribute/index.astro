---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/lib/site';

const STEPS = [
  {
    n: '01',
    title: 'Share an idea',
    body: 'Open a thread in our Blog ideas discussion on GitHub. A few sentences is enough — we will take it from there.',
  },
  {
    n: '02',
    title: 'Shape it',
    body: "We'll help you narrow the idea, find the useful angle, and decide what form it should take.",
  },
  {
    n: '03',
    title: 'Draft',
    body: 'Write in markdown, in your own voice. Add code, figures, equations, or links if they help.',
  },
  {
    n: '04',
    title: 'Review',
    body: "We'll review for clarity, correctness, and readability. Nothing fancy, just make the work easier to learn from.",
  },
  {
    n: '05',
    title: 'Publish',
    body: 'Once it is ready, we publish it and credit you as a contributor. Comments happen in GitHub Discussions.',
  },
];
---

<BaseLayout
  title="Contribute"
  description="Pitch an article, case study, primer, or tool to ML Systems. Open to anyone — engineers, researchers, students, and first-time learners sharing what they figured out."
  image="/og/page/contribute.png"
>
  <div class="container">
    <div class="page-head">
      <div class="eyebrow page-eyebrow">Write with us</div>
      <h1 class="page-h1">Contribute.</h1>
      <p class="page-lede">
        We publish articles, case studies, primers, and tools about ML systems — from anyone
        learning or working in the space. If you've figured something out and want to share it with
        the world, you should write about it here.
      </p>
    </div>

    <div
      class="contribute-grid"
      style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; margin-top: 32px;"
    >
      <div>
        <h2
          style="font-family: var(--font-display); font-size: 36px; font-weight: 400; margin: 0 0 32px; letter-spacing: -0.01em;"
        >
          The process
        </h2>
        {
          STEPS.map((s) => (
            <div style="display: grid; grid-template-columns: 80px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--line);">
              <div style="font-family: var(--font-mono); font-size: 12px; color: var(--accent);">
                {s.n}
              </div>
              <div>
                <h3 style="font-family: var(--font-display); font-size: 26px; margin: 0 0 8px; font-weight: 400;">
                  {s.title}
                </h3>
                <p style="font-size: 15px; color: var(--ink-2); margin: 0; line-height: 1.6;">
                  {s.body}
                </p>
              </div>
            </div>
          ))
        }
        <div
          style="display: grid; grid-template-columns: 80px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);"
        >
          <div></div>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <a
              href="https://github.com/orgs/MLSysDev/discussions/categories/blog-ideas"
              target="_blank"
              rel="noreferrer"
              class="btn btn-primary"
            >
              Pitch on GitHub Discussions <span class="btn-arrow">→</span>
            </a>
            <a href={`mailto:${SITE.pitchEmail}`} class="btn"> Email an idea </a>
            <a
              href="https://github.com/MLSysDev/mlsystems.dev/pulls"
              target="_blank"
              rel="noreferrer"
              class="btn"
            >
              Open a PR
            </a>
          </div>
        </div>
      </div>

      <div>
        <div class="side-panel">
          <h3 style="font-size: 22px; margin-bottom: 16px;">What we publish</h3>
          <ul
            style="padding-left: 18px; font-size: 14px; color: var(--ink-2); line-height: 1.7; margin: 0;"
          >
            <li>
              <strong>Articles</strong> — opinionated, well-argued takes on a real problem (~1,500–3,000
              words).
            </li>
            <li>
              <strong>Case studies</strong> — what happened when you actually shipped the thing.
            </li>
            <li>
              <strong>Primers</strong> — careful explainers of techniques that deserve more careful treatment.
            </li>
            <li><strong>Tools</strong> — working calculators or visualizers, with a writeup.</li>
            <li><strong>Reading lists</strong> — annotated bibliographies on narrow topics.</li>
          </ul>
        </div>

        <div class="side-panel" style="margin-top: 16px;">
          <h3 style="font-size: 18px; margin-bottom: 12px;">What we don't publish</h3>
          <ul
            style="padding-left: 18px; font-size: 13px; color: var(--ink-3); line-height: 1.7; margin: 0;"
          >
            <li>Promotional content for products.</li>
            <li>Recycled paper summaries.</li>
            <li>"X is dead, long live Y" hot takes without evidence.</li>
            <li>Listicles. Especially listicles.</li>
          </ul>
        </div>

        <div class="side-panel" style="margin-top: 16px;">
          <h3 style="font-size: 18px; margin-bottom: 12px;">Style</h3>
          <p style="font-size: 13px; color: var(--ink-2); line-height: 1.6; margin: 0 0 12px;">
            Concrete over abstract. Numbers over adjectives. One idea per paragraph. Show your work,
            including the parts that didn't.
          </p>
          <p style="font-size: 13px; color: var(--ink-2); line-height: 1.6; margin: 0;">
            We're trying to make a publication that you'd want to send to your future self. Write
            accordingly.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
