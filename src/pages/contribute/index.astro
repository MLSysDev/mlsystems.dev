---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Step from '@/components/Step.astro';
import { SITE } from '@/lib/site';

const STEPS = [
  {
    n: '01',
    title: 'Write a draft',
    body: 'Open the editor and work at your own pace. Add code, images, tables, or math where they help. Preview your article, then submit it for review.',
  },
  {
    n: '02',
    title: 'Review together',
    body: "We'll review for technical accuracy, clarity, and readability, and work with you on any changes.",
  },
  {
    n: '03',
    title: 'Share it with the community',
    body: 'Once the article is ready, we publish it under your name so others can learn from your work.',
  },
];
---

<BaseLayout
  title="Contribute"
  description="Pitch an article, case study, primer, or tool to ML Systems. Open to engineers, researchers, students, and anyone sharing what they have learned."
  image="/og/page/contribute.png"
>
  <div class="container">
    <PageIntro label="Write with us" title="Contribute">
      <p>
        Share something you've learned about ML systems. A clear explanation, a useful tool, or a
        lesson from a project can help someone else take their next step.
      </p>
    </PageIntro>

    <div
      class="contribute-grid"
      style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; margin-top: 32px;"
    >
      <div>
        <h2 class="process-h2">The process</h2>
        {STEPS.map((s) => <Step n={s.n} title={s.title} body={s.body} />)}
        <div class="process-cta">
          <div></div>
          <div class="process-cta-actions">
            <a href="/write" class="btn btn-accent">
              Start writing <span class="btn-arrow">→</span>
            </a>
            <a
              href={`${SITE.orgDiscussionsUrl}/categories/blog-ideas`}
              target="_blank"
              rel="noreferrer"
              class="btn"
            >
              Discuss an idea
            </a>
            <a href={`mailto:${SITE.pitchEmail}`} class="btn"> Email an idea </a>
          </div>
        </div>
      </div>

      <div>
        <div class="side-panel" style="border-color: var(--accent);">
          <h3 style="font-size: 20px; margin-bottom: 12px;">Have an idea first?</h3>
          <p style="font-size: 14px; color: var(--ink-2); line-height: 1.6; margin: 0 0 12px;">
            You can start a draft directly. If you'd like feedback on an idea first, <a
              href={`${SITE.orgDiscussionsUrl}/categories/blog-ideas`}
              style="color: var(--accent);">share it in Discussions</a
            > or email us.
          </p>
        </div>

        <div class="side-panel" style="margin-top: 16px;">
          <h3 style="font-size: 22px; margin-bottom: 16px;">What we publish</h3>
          <ul
            style="padding-left: 18px; font-size: 14px; color: var(--ink-2); line-height: 1.7; margin: 0;"
          >
            <li>
              <strong>Articles:</strong> well-supported explanations and perspectives on real problems.
            </li>
            <li>
              <strong>Case studies:</strong> what you built, what happened, and what you learned.
            </li>
            <li>
              <strong>Primers:</strong> clear introductions that build from the fundamentals.
            </li>
            <li><strong>Tools:</strong> working calculators or visualizers, with a writeup.</li>
            <li><strong>Reading lists:</strong> annotated bibliographies on narrow topics.</li>
          </ul>
        </div>

        <div class="side-panel" style="margin-top: 16px;">
          <h3 style="font-size: 18px; margin-bottom: 12px;">What we don't publish</h3>
          <ul
            style="padding-left: 18px; font-size: 13px; color: var(--ink-3); line-height: 1.7; margin: 0;"
          >
            <li>Promotional content for products.</li>
            <li>Recycled paper summaries.</li>
            <li>Claims without evidence or supporting examples.</li>
            <li>Lists without context or useful commentary.</li>
          </ul>
        </div>

        <div class="side-panel" style="margin-top: 16px;">
          <h3 id="style-guide" style="font-size: 18px; margin-bottom: 12px;">Style</h3>
          <p style="font-size: 13px; color: var(--ink-2); line-height: 1.6; margin: 0 0 12px;">
            Concrete over abstract. Numbers over adjectives. One idea per paragraph. Show your work,
            including the parts that didn't.
          </p>
          <p style="font-size: 13px; color: var(--ink-2); line-height: 1.6; margin: 0;">
            Link your sources, explain assumptions, and make examples easy to follow.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contribute-grid :global(.process-step) {
    grid-template-columns: 48px 1fr;
  }

  .process-h2 {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 400;
    margin: 0 0 32px;
    letter-spacing: -0.01em;
  }
  .process-cta {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .process-cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  @media (max-width: 620px) {
    .contribute-grid :global(.process-step),
    .process-cta {
      grid-template-columns: 28px 1fr;
      gap: 16px;
    }
  }
</style>
