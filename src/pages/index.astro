---
import { getCollection, getEntries } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroFigure from '@/components/HeroFigure.tsx';
import ToolGlyph from '@/components/ToolGlyph.tsx';
import { TOPICS, countPostsByTopic, formatDate, sortPostsByDate, topicName } from '@/lib/data';
import { SITE, SOCIALS } from '@/lib/site';

const allPostsRaw = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortPostsByDate);

const allPosts = await Promise.all(
  allPostsRaw.map(async (p) => ({ ...p, authors: await getEntries(p.data.authors) })),
);

const authors = await getCollection('authors');

const featured = allPosts.filter((p) => p.data.featured).slice(0, 3);
const featuredFinal = featured.length >= 3 ? featured : allPosts.slice(0, 3);

const topicCounts = countPostsByTopic(allPosts);
const articleCount = allPosts.length;
const contributorCount = authors.length;
const topicCount = TOPICS.length;

const TOPIC_PREVIEW_LIMIT = 5;
const topicsWithPosts = TOPICS.map((t) => ({
  ...t,
  posts: allPosts.filter((p) => p.data.topicId === t.id).slice(0, TOPIC_PREVIEW_LIMIT),
  totalCount: topicCounts[t.id] ?? 0,
})).filter((t) => t.totalCount > 0);
const defaultTopicId = topicsWithPosts[0]?.id ?? '';

const TAG_ORDER: Record<string, number> = { Live: 0, Beta: 1, Experimental: 2, Soon: 3 };
const allTools = await getCollection('tools', ({ data }) => !data.draft);
const featuredTools = allTools
  .filter((t) => t.data.core)
  .sort((a, b) => {
    const ta = TAG_ORDER[a.data.tag] ?? 99;
    const tb = TAG_ORDER[b.data.tag] ?? 99;
    if (ta !== tb) return ta - tb;
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return a.data.name.localeCompare(b.data.name);
  })
  .slice(0, 6);
---

<BaseLayout
  title="ML Systems — Machine learning systems: inference, training, LLMs & infrastructure"
  description="Deep dives on machine learning systems — inference, training infrastructure, GPU memory, quantization, and LLM architecture. Articles, primers, and case studies."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <h1 class="hero-h1">
            Machine learning,<br />
            from{' '}
            <button
              type="button"
              class="kernel-toggle"
              data-accent-cycle
              aria-label="Cycle site accent color"
              title="Click to change accent color"
            >
              <em>kernels</em>
            </button>
            {' '}to clusters.
          </h1>
          <p class="hero-sub">
            An open community for learning, writing, and tinkering on the infrastructure behind
            modern AI — inference engines, training systems, ml stacks, and everything in between.
          </p>
          <div class="hero-cta">
            <a href="/blog" class="btn btn-primary">
              Read the archive <span class="btn-arrow">→</span>
            </a>
            <a href="/contribute" class="btn">Write with us</a>
          </div>
          <div
            style="margin-top: 56px; display: flex; gap: 40px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);"
          >
            <div>
              <div
                style="font-size: 28px; font-family: var(--font-display); color: var(--ink); line-height: 1;"
              >
                {articleCount}
              </div>
              <div style="margin-top: 6px;">articles</div>
            </div>
            <div>
              <div
                style="font-size: 28px; font-family: var(--font-display); color: var(--ink); line-height: 1;"
              >
                {contributorCount}
              </div>
              <div style="margin-top: 6px;">contributors</div>
            </div>
            <div>
              <div
                style="font-size: 28px; font-family: var(--font-display); color: var(--ink); line-height: 1;"
              >
                {topicCount}
              </div>
              <div style="margin-top: 6px;">topics</div>
            </div>
          </div>
        </div>
        <div>
          <HeroFigure client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- LATEST -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Latest</div>
          <h2 class="section-title">Recently published.</h2>
        </div>
        <a href="/blog" class="section-link">All articles →</a>
      </div>
      <div class="latest-grid">
        {
          featuredFinal.map((p) => (
            <a class="article-card" href={`/blog/${p.id}`}>
              <div class="article-meta">
                <span class="article-topic">{topicName(p.data.topicId)}</span>
              </div>
              <h3 class="article-title">{p.data.title}</h3>
              <p class="article-summary">{p.data.summary}</p>
              <div class="article-foot">
                <span>{p.authors.map((a) => a.data.name).join(', ')}</span>
                <span>
                  {formatDate(p.data.date.toISOString())} · {p.data.readMin} min
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Index</div>
          <h2 class="section-title">Browse by topic.</h2>
        </div>
        <a href="/topics" class="section-link">Full index →</a>
      </div>
      {
        topicsWithPosts.length === 0 ? (
          <p style="color: var(--ink-3); padding: 32px 0;">No published articles yet.</p>
        ) : (
          <div class="topic-explorer" data-topic-explorer data-active-topic={defaultTopicId}>
            <div class="topic-tabs" role="tablist" aria-label="Topics">
              {topicsWithPosts.map((t) => (
                <button
                  type="button"
                  class:list={['topic-tab', { active: t.id === defaultTopicId }]}
                  role="tab"
                  aria-selected={t.id === defaultTopicId}
                  aria-controls={`topic-panel-${t.id}`}
                  data-topic={t.id}
                >
                  {t.name}
                  <span class="topic-tab-count">{t.totalCount}</span>
                </button>
              ))}
            </div>

            <div class="topic-panels">
              {topicsWithPosts.map((t) => (
                <div
                  class="topic-panel"
                  id={`topic-panel-${t.id}`}
                  role="tabpanel"
                  data-topic={t.id}
                  hidden={t.id !== defaultTopicId}
                >
                  <ul class="topic-post-list">
                    {t.posts.map((p) => (
                      <li>
                        <a href={`/blog/${p.id}`} class="topic-post">
                          <div class="topic-post-body">
                            <h3 class="topic-post-title">{p.data.title}</h3>
                            <p class="topic-post-summary">{p.data.summary}</p>
                          </div>
                          <div class="topic-post-meta">
                            <span>{p.authors.map((a) => a.data.name).join(', ')}</span>
                            <span>{formatDate(p.data.date.toISOString())}</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>

                  {t.totalCount > TOPIC_PREVIEW_LIMIT && (
                    <a href={`/blog?topic=${t.id}`} class="topic-more-link">
                      All {t.totalCount} articles in {t.name} →
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- COMMUNITY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Discourse</div>
          <h2 class="section-title">The conversation.</h2>
        </div>
        <a href="/community" class="section-link">Where to talk →</a>
      </div>
      <div class="community-grid">
        <div class="side-panel" style="grid-column: span 1;">
          <h3>GitHub Discussions</h3>
          <p>
            Long-form threads tied to GitHub identities. Best for technical questions, paper
            discussions, and feature proposals. Searchable, attributed, permanent.
          </p>
          <a
            href={SITE.orgDiscussionsUrl}
            target="_blank"
            rel="noreferrer"
            class="btn"
            style="margin-top: 16px; width: 100%; justify-content: center;"
          >
            Open Discussions →
          </a>
        </div>
        <div class="side-panel">
          <h3>Discord</h3>
          <p>
            Real-time chat for the working day. Quick questions, debugging help, paper club, and the
            occasional argument about whether MoE is overrated.
          </p>
          <a
            href={SOCIALS.discord ?? '#'}
            target="_blank"
            rel="noreferrer"
            class="btn"
            style="margin-top: 16px; width: 100%; justify-content: center;"
          >
            Join the server →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PLAYGROUND -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Tools</div>
          <h2 class="section-title">Run the math yourself.</h2>
        </div>
        <a href="/playground" class="section-link">All tools →</a>
      </div>
      <div class="tools-grid">
        {
          featuredTools.map((tool) => (
            <a href={`/playground/${tool.id}`} class="tool-card">
              <div class="tool-visual">
                <ToolGlyph id={tool.id} />
              </div>
              <h3 class="tool-name">{tool.data.name}</h3>
              <p class="tool-desc">{tool.data.summary}</p>
              <div class="tool-tag" style="color: var(--accent);">
                · {tool.data.tag} ·
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTRIBUTE CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <div>
          <div class="eyebrow" style="margin-bottom: 14px;">Contribute</div>
          <h2>Share knowledge that<br />moves the field forward.</h2>
          <p>
            We publish articles, case studies, and primers about ML systems — from anyone learning
            or working in the space. An open community built to share practical knowledge, lessons
            learned, and careful writing on work that matters.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/contribute" class="btn btn-primary">Pitch an article →</a>
          <a href="/contribute" class="btn">Read the style guide</a>
          <a href={SITE.github} target="_blank" rel="noreferrer" class="btn">Browse on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .kernel-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
  }
  .kernel-toggle em {
    color: var(--accent);
    transition: color 0.2s ease;
  }
  .kernel-toggle:hover em {
    color: var(--accent-2);
  }
  .kernel-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .topic-explorer {
    margin-top: 24px;
  }
  .topic-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    padding: 4px 0 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
    scroll-snap-type: x proximity;
  }
  .topic-tabs::-webkit-scrollbar {
    height: 4px;
  }
  .topic-tabs::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: 2px;
  }
  .topic-tab {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 99px;
    color: var(--ink-2);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    scroll-snap-align: start;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .topic-tab:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .topic-tab.active {
    background: var(--accent);
    color: var(--paper);
    border-color: var(--accent);
  }
  .topic-tab-count {
    font-family: var(--font-mono);
    font-size: 10px;
    opacity: 0.75;
    padding-left: 2px;
  }

  .topic-post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .topic-post {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 24px;
    row-gap: 8px;
    align-items: start;
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper-2);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      transform 0.18s ease;
  }
  .topic-post:hover {
    border-color: var(--accent);
    background: var(--paper);
    transform: translateY(-1px);
  }
  .topic-post-body {
    min-width: 0;
  }
  .topic-post-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .topic-post-summary {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topic-post-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 4px;
    white-space: nowrap;
  }
  .topic-more-link {
    display: inline-block;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .topic-more-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .topic-post {
      grid-template-columns: 1fr;
      column-gap: 0;
      padding: 16px 18px;
    }
    .topic-post-title {
      font-size: 19px;
    }
    .topic-post-meta {
      text-align: left;
      flex-direction: row;
      gap: 8px;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  const ACCENTS = ['oxide', 'indigo', 'emerald'] as const;
  type Accent = (typeof ACCENTS)[number];

  document.querySelectorAll<HTMLButtonElement>('[data-accent-cycle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = (root.getAttribute('data-accent') as Accent) || 'oxide';
      const idx = ACCENTS.indexOf(current);
      const next = ACCENTS[(idx + 1) % ACCENTS.length];
      root.setAttribute('data-accent', next);
      try {
        const raw = localStorage.getItem('mls.prefs');
        const prefs = raw ? JSON.parse(raw) : {};
        prefs.accent = next;
        localStorage.setItem('mls.prefs', JSON.stringify(prefs));
      } catch {}
    });
  });

  document.querySelectorAll<HTMLElement>('[data-topic-explorer]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.topic-tab');
    const panels = root.querySelectorAll<HTMLElement>('.topic-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const topic = tab.dataset.topic ?? '';
        root.dataset.activeTopic = topic;
        tabs.forEach((t) => {
          const isActive = t.dataset.topic === topic;
          t.classList.toggle('active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.topic !== topic;
        });
      });
    });
  });
</script>
