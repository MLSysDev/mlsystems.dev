---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroFigure from '@/components/HeroFigure.tsx';
import ToolGlyph from '@/components/ToolGlyph.tsx';
import Stat from '@/components/Stat.astro';
import ConceptBand from '@/components/ConceptBand.astro';
import { formatDate, sortPostsByDate } from '@/lib/data';
import { TOPICS, countPostsByTopic, topicName } from '@/lib/topics';
import { resolvePostAuthors } from '@/lib/posts';
import { pickCoreTools } from '@/lib/tools';
import { SOCIALS } from '@/lib/site';
import { SOCIAL_ICONS } from '@/lib/socialIcons';

const allPostsRaw = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortPostsByDate);
const allPosts = await resolvePostAuthors(allPostsRaw);

const authors = await getCollection('authors');

const featured = allPosts.filter((p) => p.data.featured).slice(0, 3);
const featuredIds = new Set(featured.map((p) => p.id));
const recent = allPosts.filter((p) => !featuredIds.has(p.id)).slice(0, 6);

const topicCounts = countPostsByTopic(allPosts);
const articleCount = allPosts.length;
const contributorCount = authors.length;

const TOPIC_PREVIEW_LIMIT = 5;
const topicsWithPosts = TOPICS.map((t) => ({
  ...t,
  posts: allPosts.filter((p) => p.data.topicId === t.id).slice(0, TOPIC_PREVIEW_LIMIT),
  totalCount: topicCounts[t.id] ?? 0,
})).filter((t) => t.totalCount > 0);
const defaultTopicId = topicsWithPosts[0]?.id ?? '';

const allTools = await getCollection('tools', ({ data }) => !data.draft);
const featuredTools = pickCoreTools(allTools);
---

<BaseLayout
  title="Machine Learning Systems — an open community for builders"
  description="ML Systems — an open archive on machine learning systems: inference, training infrastructure, GPU memory, quantization, transformers, and LLMs."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="masthead-bar">
        <span class="masthead-name">ML Systems</span>
        <span class="masthead-meta">An open archive · Est. 2026</span>
      </div>
      <div class="hero-grid">
        <div>
          <h1 class="hero-h1">
            Machine learning,<br />
            from{' '}
            <button
              type="button"
              class="kernel-toggle"
              data-accent-cycle
              aria-label="Cycle site accent color"
              title="Click to change accent color"
            >
              <em>kernels</em>
            </button>
            {' '}to clusters.
          </h1>
          <p class="hero-sub">
            An open community for learning, writing, and tinkering on the infrastructure behind
            modern AI — inference engines, training systems, ml stacks, and everything in between.
          </p>
          <div class="hero-cta">
            <a href="/blog" class="btn btn-primary">
              Read the archive <span class="btn-arrow">→</span>
            </a>
            <a href="/contribute" class="btn">Write with us</a>
          </div>
          <div style="margin-top: 56px; display: flex; gap: 40px; flex-wrap: wrap;">
            <Stat value={articleCount} label="articles" />
            <Stat value={contributorCount} label="contributors" />
          </div>
        </div>
        <div>
          <HeroFigure client:visible />
        </div>
      </div>
    </div>
  </section>

  <ConceptBand hero items={['kernel', 'attention', 'cluster', 'network']} />

  {
    featured.length > 0 && (
      <section class="section" style="padding-top: 0;">
        <div class="container">
          <div class="section-head">
            <div>
              <div class="eyebrow">Featured</div>
              <h2 class="section-title">Editors' picks.</h2>
            </div>
            <a href="/blog" class="section-link">
              All articles →
            </a>
          </div>
          <ol class="idx-list">
            {featured.map((p, i) => (
              <li class="idx-row">
                <a class="idx-link" href={`/blog/${p.id}`}>
                  <span class="idx-num">{String(i + 1).padStart(2, '0')}</span>
                  <div class="idx-main">
                    <h3 class="idx-title">{p.data.title}</h3>
                    <p class="idx-sum">{p.data.summary}</p>
                    <div class="idx-meta">
                      {p.data.topicId && <span class="idx-topic">{topicName(p.data.topicId)}</span>}
                      <span>{p.authors.map((a) => a.data.name).join(', ')}</span>
                      <span>
                        {formatDate(p.data.date)} · {p.data.readMin} min
                      </span>
                    </div>
                  </div>
                  <span class="idx-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="section" style={featured.length > 0 ? undefined : 'padding-top: 0;'}>
        <div class="container">
          <div class="section-head">
            <div>
              <div class="eyebrow">Latest</div>
              <h2 class="section-title">Recently published.</h2>
            </div>
            <a href="/blog" class="section-link">
              All articles →
            </a>
          </div>
          <ol class="idx-list">
            {recent.map((p, i) => (
              <li class="idx-row">
                <a class="idx-link" href={`/blog/${p.id}`}>
                  <span class="idx-num">{String(i + 1).padStart(2, '0')}</span>
                  <div class="idx-main">
                    <h3 class="idx-title">{p.data.title}</h3>
                    <p class="idx-sum">{p.data.summary}</p>
                    <div class="idx-meta">
                      {p.data.topicId && <span class="idx-topic">{topicName(p.data.topicId)}</span>}
                      <span>{p.authors.map((a) => a.data.name).join(', ')}</span>
                      <span>
                        {formatDate(p.data.date)} · {p.data.readMin} min
                      </span>
                    </div>
                  </div>
                  <span class="idx-arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <ConceptBand items={['tokenize', 'train', 'serve', 'scale']} />

  <!-- TOPICS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Index</div>
          <h2 class="section-title">Browse by topic.</h2>
        </div>
        <a href="/topics" class="section-link">Full index →</a>
      </div>
      {
        topicsWithPosts.length === 0 ? (
          <p style="color: var(--ink-3); padding: 32px 0;">No published articles yet.</p>
        ) : (
          <div class="topic-explorer" data-topic-explorer data-active-topic={defaultTopicId}>
            <div class="topic-tabs" role="tablist" aria-label="Topics">
              {topicsWithPosts.map((t) => (
                <button
                  type="button"
                  class:list={[
                    'chip',
                    'chip--interactive',
                    { 'is-active': t.id === defaultTopicId },
                  ]}
                  role="tab"
                  aria-selected={t.id === defaultTopicId}
                  aria-controls={`topic-panel-${t.id}`}
                  data-topic={t.id}
                >
                  {t.name}
                  <span class="chip__count">{t.totalCount}</span>
                </button>
              ))}
            </div>

            <div class="topic-panels">
              {topicsWithPosts.map((t) => (
                <div
                  class="topic-panel"
                  id={`topic-panel-${t.id}`}
                  role="tabpanel"
                  data-topic={t.id}
                  hidden={t.id !== defaultTopicId}
                >
                  <ul class="topic-post-list">
                    {t.posts.map((p) => (
                      <li>
                        <a href={`/blog/${p.id}`} class="topic-post">
                          <div class="topic-post-body">
                            <h3 class="topic-post-title">{p.data.title}</h3>
                            <p class="topic-post-summary">{p.data.summary}</p>
                          </div>
                          <div class="topic-post-meta">
                            <span>{p.authors.map((a) => a.data.name).join(', ')}</span>
                            <span>{formatDate(p.data.date)}</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>

                  {t.totalCount > TOPIC_PREVIEW_LIMIT && (
                    <a href={`/topics/${t.id}`} class="topic-more-link">
                      All {t.totalCount} articles in {t.name} →
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- PLAYGROUND -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Tools</div>
          <h2 class="section-title">Run the math yourself.</h2>
        </div>
        <a href="/playground" class="section-link">All tools →</a>
      </div>
      <div class="tools-grid">
        {
          featuredTools.map((tool) => (
            <a href={`/playground/${tool.id}`} class="tool-card">
              <div class="tool-visual">
                <ToolGlyph id={tool.id} />
              </div>
              <h3 class="tool-name">{tool.data.name}</h3>
              <p class="tool-desc">{tool.data.summary}</p>
              <span class="chip chip--sm chip--beta">{tool.data.tag}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- COMMUNITY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Discourse</div>
          <h2 class="section-title">The conversation.</h2>
        </div>
        <a href="/community" class="section-link">Where to talk →</a>
      </div>
      <div class="community-grid">
        <div class="side-panel">
          <h3 class="side-panel-title">
            <svg
              class="side-panel-icon"
              viewBox="0 0 16 16"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M1 2.5A1.5 1.5 0 0 1 2.5 1h11A1.5 1.5 0 0 1 15 2.5v7A1.5 1.5 0 0 1 13.5 11H8.62l-3.5 3.15A.5.5 0 0 1 4.3 14v-3H2.5A1.5 1.5 0 0 1 1 9.5v-7Z"
              ></path>
            </svg>
            Forum Discussions
          </h3>
          <p>Ask questions, share what you built, run a poll, or just discuss ML systems.</p>
          <a
            href="/forum"
            class="btn"
            style="margin-top: 16px; width: 100%; justify-content: center;"
          >
            Open the Forum →
          </a>
        </div>
        <div class="side-panel">
          <h3 class="side-panel-title">
            <svg
              class="side-panel-icon"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={SOCIAL_ICONS.discord.path}></path>
            </svg>
            Discord
          </h3>
          <p>
            Real-time chat for the working day. Quick questions, debugging help, paper club, and the
            occasional argument about whether MoE is overrated.
          </p>
          <a
            href={SOCIALS.discord ?? '#'}
            target="_blank"
            rel="noreferrer"
            class="btn"
            style="margin-top: 16px; width: 100%; justify-content: center;"
          >
            Join the server →
          </a>
        </div>
      </div>
    </div>
  </section>

  <ConceptBand items={['vram', 'quantize', 'batch', 'gradient']} />

  <!-- CONTRIBUTE CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <div>
          <div class="eyebrow" style="margin-bottom: 14px;">Contribute</div>
          <h2>Share knowledge that<br />moves the field forward.</h2>
          <p>
            We publish articles, case studies, and primers about ML systems — from anyone learning
            or working in the space. An open community built to share practical knowledge, lessons
            learned, and careful writing on work that matters.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/write" class="btn btn-accent"
            >Write an article <span class="btn-arrow">→</span></a
          >
          <a href="/contribute" class="btn">Pitch an article</a>
          <a href="/why" class="cta-github-link">Why this exists →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Zine masthead — a running rule with mono wordmark + tagline at the ends */
  .masthead-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .masthead-name {
    font-weight: 600;
    color: var(--ink);
  }
  .masthead-meta {
    color: var(--ink-3);
  }
  @media (max-width: 560px) {
    .masthead-meta {
      display: none;
    }
  }

  /* Editorial index — numbered, ruled list instead of a card grid */
  .idx-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .idx-row {
    border-bottom: 1px solid var(--line);
  }
  .idx-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: 28px;
    padding: 26px 8px;
    color: inherit;
    text-decoration: none;
    transition:
      background 0.15s ease,
      padding 0.18s ease;
  }
  .idx-link:hover {
    background: var(--accent-soft);
    padding-left: 16px;
    padding-right: 16px;
  }
  .idx-num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-4);
    letter-spacing: 0.04em;
    padding-top: 6px;
    transition: color 0.15s ease;
  }
  .idx-link:hover .idx-num {
    color: var(--accent);
  }
  .idx-main {
    min-width: 0;
  }
  .idx-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0 0 10px;
    transition: color 0.15s ease;
  }
  .idx-link:hover .idx-title {
    color: var(--accent);
  }
  .idx-sum {
    font-family: var(--font-read);
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 14px;
    max-width: 60ch;
  }
  .idx-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.03em;
    color: var(--ink-3);
    text-transform: uppercase;
  }
  .idx-topic {
    color: var(--accent);
    font-weight: 500;
  }
  .idx-arrow {
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--ink-4);
    align-self: center;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      color 0.15s ease;
  }
  .idx-link:hover .idx-arrow {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .idx-link {
      grid-template-columns: auto 1fr;
      column-gap: 16px;
      padding: 22px 4px;
    }
    .idx-arrow {
      display: none;
    }
    .idx-title {
      margin-bottom: 8px;
    }
  }

  .kernel-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
  }
  .kernel-toggle em {
    color: var(--accent);
    transition: color 0.2s ease;
  }
  .kernel-toggle:hover em {
    color: var(--accent-2);
  }
  .kernel-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .topic-explorer {
    margin-top: 24px;
  }
  .topic-tabs {
    display: flex;
    gap: 8px;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--line-2) transparent;
    -webkit-overflow-scrolling: touch;
    padding: 4px 0 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
    scroll-snap-type: x proximity;
  }
  .topic-tabs::-webkit-scrollbar {
    height: 6px;
  }
  .topic-tabs::-webkit-scrollbar-track {
    background: transparent;
  }
  .topic-tabs::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: var(--radius-pill);
  }
  .topic-tabs:hover::-webkit-scrollbar-thumb {
    background: var(--ink-4);
  }
  .topic-tabs .chip {
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  .tool-card .chip {
    margin-top: auto;
    align-self: flex-start;
  }

  .topic-post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .topic-post {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 24px;
    row-gap: 8px;
    align-items: start;
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-2);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease,
      transform 0.18s ease;
  }
  .topic-post:hover {
    border-color: var(--accent);
    background: var(--paper);
    transform: translateY(-1px);
  }
  .topic-post-body {
    min-width: 0;
  }
  .topic-post-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    line-height: 1.25;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .topic-post-summary {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topic-post-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 4px;
    white-space: nowrap;
  }
  .topic-more-link {
    display: inline-block;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .topic-more-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .topic-post {
      grid-template-columns: 1fr;
      column-gap: 0;
      padding: 16px 18px;
    }
    .topic-post-title {
      font-size: 19px;
    }
    .topic-post-meta {
      text-align: left;
      flex-direction: row;
      gap: 8px;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  import { ACCENTS, writePrefs, type Accent } from '@/lib/prefs';
  import { neuralBurst } from '@/lib/neuralBurst';

  document.querySelectorAll<HTMLButtonElement>('[data-accent-cycle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = (root.getAttribute('data-accent') as Accent) || 'oxide';
      const idx = ACCENTS.indexOf(current);
      const next = ACCENTS[(idx + 1) % ACCENTS.length];
      root.setAttribute('data-accent', next);
      writePrefs({ accent: next });
      const hero = btn.closest<HTMLElement>('.hero');
      if (hero) neuralBurst(hero);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-topic-explorer]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    const panels = root.querySelectorAll<HTMLElement>('.topic-panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const topic = tab.dataset.topic ?? '';
        root.dataset.activeTopic = topic;
        tabs.forEach((t) => {
          const isActive = t.dataset.topic === topic;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.topic !== topic;
        });
      });
    });
  });
</script>
