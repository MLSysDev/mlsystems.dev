---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroFigure from '@/components/HeroFigure';
import ToolGlyph from '@/components/ToolGlyph.tsx';
import { formatDate, sortPostsByDate } from '@/lib/data';
import { TOPICS, countPostsByTopic, topicName } from '@/lib/topics';
import { resolvePostAuthors } from '@/lib/posts';
import { pickCoreTools, rankTools } from '@/lib/tools';

const allPosts = await resolvePostAuthors(
  (await getCollection('posts', ({ data }) => !data.draft)).sort(sortPostsByDate),
);
const lead = allPosts.find((post) => post.data.featured) ?? allPosts[0];
const reading = allPosts.filter((post) => post.id !== lead?.id).slice(0, 3);
const counts = countPostsByTopic(allPosts);
const topics = TOPICS.filter((topic) => counts[topic.id] > 0).slice(0, 3);
const moreTopics = TOPICS.filter((topic) => !topics.some((featured) => featured.id === topic.id));
const allTools = rankTools(await getCollection('tools', ({ data }) => !data.draft));
const tools = pickCoreTools(allTools, 4);
const moreTools = allTools.filter((tool) => !tools.some((featured) => featured.id === tool.id));
---

<BaseLayout
  title="ML Systems — Machine learning systems, from kernels to clusters"
  description="ML Systems is an open community publication on machine learning systems: inference engines, training infrastructure, GPU memory, and everything in between."
>
  <div class="publication container">
    <section class="publication-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="publication-label">
          <span class="publication-dot" aria-hidden="true"></span> A community publication
        </p>
        <h1 id="home-title">
          Inside machine<br /><em
            ><button
              class="accent-cycle"
              data-accent-cycle
              aria-label="learning. Change theme color"
              title="Change theme color">learning.</button
            ></em
          >
        </h1>
        <p class="publication-deck">From kernels to clusters.</p>
        <p class="publication-intro">
          An open community for learning, writing, and tinkering on the infrastructure behind modern
          AI: inference engines, training systems, ML stacks, and everything in between.
        </p>
        <div class="publication-hero-actions">
          <a class="hero-button hero-button-primary" href="/blog">
            Read the archive <span aria-hidden="true">→</span>
          </a>
          <a class="hero-button" href="/contribute">Write with us</a>
        </div>
      </div>
      <HeroFigure client:load />
    </section>

    {
      lead && (
        <section class="publication-section reading-section" aria-labelledby="writing-title">
          <div class="publication-section-head">
            <h2 id="writing-title">The reading room</h2>
            <a class="publication-small-link" href="/blog">
              All articles <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class:list={['reading-layout', { 'reading-layout--single': reading.length === 0 }]}>
            <article class="lead-story">
              <p class="publication-label">
                {lead.data.featured ? 'Featured article' : 'Latest article'}{' '}
                <span aria-hidden="true">/</span> {topicName(lead.data.topicId)}
              </p>
              <h3>
                <a href={`/blog/${lead.id}`}>{lead.data.title}</a>
              </h3>
              <p class="lead-summary">{lead.data.summary}</p>
              <div class="story-meta">
                <>
                  <span>{lead.authors.map((author) => author.data.name).join(', ')}</span>
                  <span>{lead.data.readMin} min read</span>
                </>
              </div>
              <a class="publication-link" href={`/blog/${lead.id}`}>
                Read the article <span aria-hidden="true">↗</span>
              </a>
            </article>
            {reading.length > 0 && (
              <div class="reading-list">
                {reading.map((post) => (
                  <article class="reading-item">
                    <p class="publication-label">
                      {topicName(post.data.topicId)} <span aria-hidden="true">/</span>{' '}
                      {post.data.readMin} min read
                    </p>
                    <h3>
                      <a href={`/blog/${post.id}`}>{post.data.title}</a>
                    </h3>
                    <p class="story-meta">
                      {post.authors.map((author) => author.data.name).join(', ')}{' '}
                      <span aria-hidden="true">·</span>{' '}
                      <time datetime={post.data.date.toISOString()}>
                        {formatDate(post.data.date)}
                      </time>
                    </p>
                  </article>
                ))}
              </div>
            )}
          </div>
          <div class="reading-more">
            <a href="/blog">
              Browse all articles <span aria-hidden="true">→</span>
            </a>
          </div>
        </section>
      )
    }

    {
      topics.length > 0 && (
        <section class="publication-section topic-section" aria-labelledby="explore-title">
          <div class="publication-section-head">
            <h2 id="explore-title">Find your thread</h2>
            <a class="publication-small-link" href="/topics">
              Topic index <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="publication-topics">
            {topics.map((topic, index) => (
              <a class="publication-topic" href={`/topics/${topic.id}`}>
                <span class="topic-index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3>{topic.name}</h3>
                  <p>{topic.desc}</p>
                </div>
                <span class="topic-end">
                  {counts[topic.id]} {counts[topic.id] === 1 ? 'article' : 'articles'}
                </span>
              </a>
            ))}
          </div>
          {moreTopics.length > 0 && (
            <div class="publication-more-topics">
              <p class="publication-label">More threads to explore</p>
              <nav class="publication-topic-chips" aria-label="More topics">
                {moreTopics.map((topic) => (
                  <a href={`/topics/${topic.id}`} title={topic.desc}>
                    {topic.name}
                  </a>
                ))}
              </nav>
            </div>
          )}
        </section>
      )
    }

    {
      tools.length > 0 && (
        <section class="publication-section tools-section" aria-labelledby="tools-title">
          <div class="publication-section-head">
            <h2 id="tools-title">ML systems, hands-on.</h2>
            <a class="publication-small-link" href="/playground">
              All tools <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="publication-tools">
            {tools.map((tool) => (
              <a class="publication-tool" href={`/playground/${tool.id}`}>
                <div class="publication-tool-icon" aria-hidden="true">
                  <ToolGlyph id={tool.id} />
                </div>
                <div>
                  <h3>
                    {tool.data.name} <span aria-hidden="true">↗</span>
                  </h3>
                  <p>{tool.data.summary}</p>
                </div>
              </a>
            ))}
          </div>
          {moreTools.length > 0 && (
            <div class="publication-more-tools">
              <p class="publication-label">More to try</p>
              <nav class="publication-topic-chips" aria-label="More playground tools">
                {moreTools.map((tool) => (
                  <a href={`/playground/${tool.id}`}>
                    {tool.data.name}
                    {tool.data.tag !== 'Live' && (
                      <span class="publication-chip-tag">{tool.data.tag}</span>
                    )}
                  </a>
                ))}
              </nav>
            </div>
          )}
        </section>
      )
    }

    <section class="publication-invitation" aria-labelledby="contribute-title">
      <div>
        <p class="publication-label">Knowledge grows when it's shared.</p><h2 id="contribute-title">
          A place for<br /><em>curious minds.</em>
        </h2>
      </div>
      <div class="invitation-copy">
        <p>
          A useful explanation. A hard-won lesson. A question worth exploring. If you're learning or
          building ML systems, there's a place for your perspective here.
        </p><div class="invitation-actions">
          <a class="publication-link" href="/contribute"
            >Write with us <span aria-hidden="true">↗</span></a
          ><a class="publication-small-link" href="/community"
            >Meet the community <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .publication {
    --section-space: clamp(24px, 3vw, 32px);
    --hero-header-height: 80px;
  }
  .publication-hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    align-content: center;
    /* Fill the opening screen, while keeping tall displays from stretching the hero. */
    min-height: min(900px, calc(100svh - var(--hero-header-height)));
    gap: 52px;
    padding: 36px 0 var(--section-space);
  }
  .publication-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 48px;
    padding: 12px 20px;
    border: 1px solid var(--line-2);
    border-radius: 6px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    transition:
      background 180ms,
      border-color 180ms,
      color 180ms;
  }
  .hero-button-primary {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .hero-button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .hero-button-primary:hover {
    background: var(--accent);
    color: var(--paper);
  }
  .publication-label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0;
  }
  .publication-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
  }
  .hero-copy h1 {
    font-family: var(--font-display);
    font-size: clamp(56px, 6.8vw, 92px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.055em;
    margin: 20px 0 22px;
  }
  .hero-copy h1 em,
  .publication-invitation em {
    color: var(--accent);
    font-weight: 400;
  }
  .publication-deck {
    font-family: var(--font-read);
    font-size: clamp(26px, 2.5vw, 34px);
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin: 0 0 12px;
  }
  .publication-intro {
    max-width: 480px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.65;
    margin: 0 0 30px;
  }
  .publication-link {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 8px 0;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
  }
  .publication-link span {
    font-size: 20px;
    line-height: 1;
  }
  .publication-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .publication-small-link {
    font-size: 13px;
    display: inline-flex;
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    color: var(--ink-2);
  }
  .publication-small-link:hover {
    color: var(--accent);
  }
  .publication-section {
    border-top: 1px solid var(--line-2);
    padding: 28px 0 var(--section-space);
  }
  .publication-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .publication-section-head h2 {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 400;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .reading-section {
    padding-bottom: var(--section-space);
  }
  .reading-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 3.5vw, 40px);
  }
  .reading-more a {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    padding: 12px 22px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .reading-more a:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .reading-more a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .reading-layout {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 64px;
  }
  .reading-layout--single {
    grid-template-columns: minmax(0, 760px);
  }
  .lead-story {
    padding-right: 56px;
    border-right: 1px solid var(--line);
  }
  .reading-layout--single .lead-story {
    padding-right: 0;
    border: 0;
  }
  .lead-story h3 {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.035em;
    margin: 18px 0;
    text-wrap: pretty;
  }
  .lead-summary {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
    margin: 0 0 22px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 12px;
    color: var(--ink-3);
    line-height: 1.6;
    margin: 0;
  }
  .lead-story .publication-link {
    margin-top: 24px;
  }
  .reading-item {
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .reading-item:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .reading-item:last-child {
    padding-bottom: 0;
  }
  .reading-item h3 {
    font-family: var(--font-read);
    font-weight: 400;
    font-size: 23px;
    letter-spacing: -0.025em;
    line-height: 1.3;
    margin: 10px 0 12px;
  }
  .topic-section:has(.publication-more-topics),
  .tools-section:has(.publication-more-tools) {
    padding-bottom: calc(var(--section-space) - 22px);
  }
  .topic-section .publication-more-topics,
  .tools-section .publication-more-tools {
    margin-top: 50px;
    min-width: 0;
  }
  .topic-section .publication-more-topics .publication-label,
  .tools-section .publication-more-tools .publication-label {
    margin-bottom: 12px;
  }
  .publication-topics {
    display: grid;
  }
  .publication-topic {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .publication-topic:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .publication-topic:last-child {
    padding-bottom: 0;
  }
  .topic-index {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-3);
  }
  .publication-topic h3 {
    font-family: var(--font-read);
    font-weight: 400;
    font-size: 27px;
    letter-spacing: -0.03em;
    margin: 0 0 6px;
  }
  .publication-topic p {
    font-size: 15px;
    color: var(--ink-2);
    margin: 0;
    max-width: 680px;
    line-height: 1.6;
  }
  .topic-end {
    font-size: 12px;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .publication-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .publication-tool {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }
  .publication-tool-icon {
    flex: 0 0 56px;
    padding-top: 4px;
  }
  .publication-tool h3 {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .publication-tool h3 span {
    color: var(--ink-3);
  }
  .publication-tool p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-2);
    margin: 0;
  }
  .publication-invitation {
    border-top: 1px solid var(--line-2);
    position: relative;
    isolation: isolate;
    padding: clamp(64px, 7vw, 96px) 24px;
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
  }
  .publication-invitation::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 48%,
      color-mix(in srgb, var(--accent) 9%, transparent),
      color-mix(in srgb, var(--accent) 3%, transparent) 45%,
      transparent 75%
    );
  }
  .publication-invitation .publication-label {
    justify-content: center;
  }
  .publication-invitation h2 {
    font-family: var(--font-display);
    font-size: clamp(40px, 4.6vw, 60px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.04em;
    margin: 20px 0 0;
  }
  .invitation-copy p {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.7;
    max-width: 540px;
    margin: 0 auto 24px;
  }
  .invitation-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .invitation-copy .publication-small-link {
    display: flex;
    width: fit-content;
    margin-top: 0;
  }
  @media (max-width: 1000px) {
    .publication-hero {
      gap: 24px;
    }
    .reading-layout,
    .publication-tools {
      gap: 36px;
    }
    .lead-story {
      padding-right: 32px;
    }
  }
  @media (max-width: 900px) {
    .publication {
      --hero-header-height: 72px;
    }
  }
  @media (max-width: 720px) {
    .publication-hero {
      grid-template-columns: 1fr;
      padding: 28px 0 var(--section-space);
      gap: 20px;
    }
    .hero-copy h1 {
      font-size: clamp(52px, 10.8vw, 76px);
    }
    .publication-intro {
      max-width: 440px;
    }
    .publication-deck {
      font-size: 26px;
    }
    .publication-section-head {
      margin-bottom: 28px;
      gap: 12px;
      align-items: center;
    }
    .publication-section-head h2 {
      max-width: 65%;
    }
    .publication-small-link {
      font-size: 12px;
      gap: 6px;
    }
    .reading-layout,
    .publication-tools {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .lead-story {
      border-right: 0;
      padding: 0 0 32px;
      border-bottom: 1px solid var(--line);
    }
    .lead-story h3 {
      font-size: 32px;
    }
    .reading-item h3 {
      font-size: 23px;
    }
    .topic-section:has(.publication-more-topics),
    .tools-section:has(.publication-more-tools) {
      padding-bottom: calc(var(--section-space) - 16px);
    }
    .topic-section .publication-more-topics,
    .tools-section .publication-more-tools {
      margin-top: 40px;
    }
    .publication-topic {
      grid-template-columns: 24px 1fr auto;
      gap: 12px;
    }
    .publication-topic h3 {
      font-size: 24px;
    }
    .publication-tool {
      gap: 20px;
    }
    .publication-tool h3 {
      font-size: 19px;
    }
    .invitation-copy p {
      font-size: 17px;
    }
  }
</style>

<script>
  import { ACCENTS, writePrefs, type Accent } from '@/lib/prefs';
  document.querySelectorAll<HTMLButtonElement>('[data-accent-cycle]').forEach((button) => {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const current = root.getAttribute('data-accent') as Accent;
      const next = ACCENTS[(ACCENTS.indexOf(current) + 1) % ACCENTS.length];
      root.setAttribute('data-accent', next);
      writePrefs({ accent: next });
    });
  });
</script>
