---
import { getCollection, getEntries } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroFigure from '@/components/HeroFigure.tsx';
import ToolGlyph from '@/components/ToolGlyph.tsx';
import { TOPICS, TOOLS, countPostsByTopic, formatDate } from '@/lib/data';
import { SITE, SOCIALS } from '@/lib/site';

const allPostsRaw = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);

const allPosts = await Promise.all(
  allPostsRaw.map(async (p) => ({ ...p, authors: await getEntries(p.data.authors) })),
);

const authors = await getCollection('authors');

const featured = allPosts.filter((p) => p.data.featured).slice(0, 3);
const featuredFinal = featured.length >= 3 ? featured : allPosts.slice(0, 3);

const topicCounts = countPostsByTopic(allPosts);
const articleCount = allPosts.length;
const contributorCount = authors.length;
const topicCount = TOPICS.length;
---

<BaseLayout
  title="ML Systems — An open archive for the engineers building modern AI"
  description="An open community for learning, writing, and tinkering on the infrastructure behind modern AI — inference engines, training systems, ml stacks, and everything in between."
>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <h1 class="hero-h1">
            Machine learning,<br />
            from{' '}
            <button
              type="button"
              class="kernel-toggle"
              data-accent-cycle
              aria-label="Cycle site accent color"
              title="Click to change accent color"
            >
              <em>kernels</em>
            </button>
            {' '}to clusters.
          </h1>
          <p class="hero-sub">
            An open community for learning, writing, and tinkering on the infrastructure behind
            modern AI — inference engines, training systems, ml stacks, and everything in between.
          </p>
          <div class="hero-cta">
            <a href="/blog" class="btn btn-primary">
              Read the archive <span class="btn-arrow">→</span>
            </a>
            <a href="/contribute" class="btn">Write with us</a>
          </div>
          <div
            style="margin-top: 56px; display: flex; gap: 40px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 12px; color: var(--ink-3);"
          >
            <div>
              <div
                style="font-size: 28px; font-family: var(--font-display); color: var(--ink); line-height: 1;"
              >
                {articleCount}
              </div>
              <div style="margin-top: 6px;">articles</div>
            </div>
            <div>
              <div
                style="font-size: 28px; font-family: var(--font-display); color: var(--ink); line-height: 1;"
              >
                {contributorCount}
              </div>
              <div style="margin-top: 6px;">contributors</div>
            </div>
            <div>
              <div
                style="font-size: 28px; font-family: var(--font-display); color: var(--ink); line-height: 1;"
              >
                {topicCount}
              </div>
              <div style="margin-top: 6px;">topics</div>
            </div>
          </div>
        </div>
        <div>
          <HeroFigure client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- LATEST -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Latest</div>
          <h2 class="section-title">Recently published.</h2>
        </div>
        <a href="/blog" class="section-link">All articles →</a>
      </div>
      <div class="latest-grid">
        {
          featuredFinal.map((p) => (
            <a class="article-card" href={`/blog/${p.id}`}>
              <div class="article-meta">
                <span class="article-id">[{p.data.id}]</span>
                <span class="article-topic">{p.data.topic}</span>
              </div>
              <h3 class="article-title">{p.data.title}</h3>
              <p class="article-summary">{p.data.summary}</p>
              <div class="article-foot">
                <span>{p.authors.map((a) => a.data.name).join(', ')}</span>
                <span>
                  {formatDate(p.data.date.toISOString())} · {p.data.readMin} min
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Index</div>
          <h2 class="section-title">Browse by topic.</h2>
        </div>
        <a href="/topics" class="section-link">Full index →</a>
      </div>
      <div class="topics-list">
        {
          TOPICS.map((t, i) => (
            <a href={`/blog?topic=${t.id}`} class="topic-row">
              <span class="topic-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="topic-name">{t.name}</h3>
              <span class="topic-desc">{t.desc}</span>
              <span class="topic-count">{topicCounts[t.id] ?? 0} articles</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- COMMUNITY -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Discourse</div>
          <h2 class="section-title">The conversation.</h2>
        </div>
        <a href="/community" class="section-link">Where to talk →</a>
      </div>
      <div class="community-grid">
        <div class="side-panel" style="grid-column: span 1;">
          <h3>GitHub Discussions</h3>
          <p>
            Long-form threads tied to GitHub identities. Best for technical questions, paper
            discussions, and feature proposals. Searchable, attributed, permanent.
          </p>
          <a
            href="https://github.com/orgs/MLSysDev/discussions"
            target="_blank"
            rel="noreferrer"
            class="btn"
            style="margin-top: 16px; width: 100%; justify-content: center;"
          >
            Open Discussions →
          </a>
        </div>
        <div class="side-panel">
          <h3>Discord</h3>
          <p>
            Real-time chat for the working day. Quick questions, debugging help, paper club, and the
            occasional argument about whether MoE is overrated.
          </p>
          <a
            href={SOCIALS.discord ?? '#'}
            target="_blank"
            rel="noreferrer"
            class="btn"
            style="margin-top: 16px; width: 100%; justify-content: center;"
          >
            Join the server →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PLAYGROUND -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Tools</div>
          <h2 class="section-title">Run the math yourself.</h2>
        </div>
        <a href="/playground" class="section-link">All tools →</a>
      </div>
      <div class="tools-grid">
        {
          TOOLS.map((tool) => (
            <a href="/playground" class="tool-card">
              <div class="tool-visual">
                <ToolGlyph id={tool.id} />
              </div>
              <h3 class="tool-name">{tool.name}</h3>
              <p class="tool-desc">{tool.desc}</p>
              <div class="tool-tag" style="color: var(--accent);">
                · {tool.tag} ·
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTRIBUTE CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <div>
          <div class="eyebrow" style="margin-bottom: 14px;">Contribute</div>
          <h2>Share knowledge that<br />moves the field forward.</h2>
          <p>
            We publish articles, case studies, and primers from engineers working on the hard parts
            of ML systems. Built by the community to share practical knowledge, hard-won lessons,
            and careful writing on work that matters.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/contribute" class="btn btn-primary">Pitch an article →</a>
          <a href="/contribute" class="btn">Read the style guide</a>
          <a href={SITE.github} target="_blank" rel="noreferrer" class="btn">Browse on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .kernel-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease;
  }
  .kernel-toggle em {
    color: var(--accent);
    transition: color 0.2s ease;
  }
  .kernel-toggle:hover em {
    color: var(--accent-2);
  }
  .kernel-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>

<script>
  const ACCENTS = ['oxide', 'indigo', 'emerald'] as const;
  type Accent = (typeof ACCENTS)[number];

  document.querySelectorAll<HTMLButtonElement>('[data-accent-cycle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const current = (root.getAttribute('data-accent') as Accent) || 'oxide';
      const idx = ACCENTS.indexOf(current);
      const next = ACCENTS[(idx + 1) % ACCENTS.length];
      root.setAttribute('data-accent', next);
      try {
        const raw = localStorage.getItem('mls.prefs');
        const prefs = raw ? JSON.parse(raw) : {};
        prefs.accent = next;
        localStorage.setItem('mls.prefs', JSON.stringify(prefs));
      } catch {}
    });
  });
</script>
