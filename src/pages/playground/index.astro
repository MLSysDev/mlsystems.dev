---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Playground from '@/components/Playground.tsx';
import { EXTERNAL_TOOLS } from '@/lib/data';

const allTools = await getCollection('tools', ({ data }) => !data.draft);

const TAG_ORDER: Record<string, number> = { Live: 0, Beta: 1, Experimental: 2, Soon: 3 };
const coreTools = allTools
  .filter((t) => t.data.core)
  .sort((a, b) => {
    const ta = TAG_ORDER[a.data.tag] ?? 99;
    const tb = TAG_ORDER[b.data.tag] ?? 99;
    if (ta !== tb) return ta - tb;
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return a.data.name.localeCompare(b.data.name);
  })
  .slice(0, 6)
  .map((t) => ({
    id: t.id,
    name: t.data.name,
    desc: t.data.summary,
    tag: t.data.tag,
    available: t.data.tag === 'Live',
  }));

const catalogTools = allTools.sort((a, b) => {
  const ta = TAG_ORDER[a.data.tag] ?? 99;
  const tb = TAG_ORDER[b.data.tag] ?? 99;
  if (ta !== tb) return ta - tb;
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.name.localeCompare(b.data.name);
});
---

<BaseLayout
  title="Playground"
  description="Working calculators, visualizers, and benchmarks for ML systems work — throughput, attention, cost."
  image="/og/page/playground.png"
>
  <div class="container">
    <div class="page-head">
      <div class="eyebrow page-eyebrow">Playground</div>
      <h1 class="page-h1">Tools.</h1>
      <p class="page-lede">
        Working calculators, visualizers, and benchmarks for ML systems work. Open source, no auth,
        no telemetry. Pick a tool below.
      </p>
    </div>

    <Playground tools={coreTools} client:visible />

    <section class="more-tools">
      <div class="more-tools-head">
        <div class="eyebrow">Browse all</div>
        <h2 class="more-tools-title">All tools & demos.</h2>
      </div>

      <div class="tools-catalog" data-tools-catalog>
        <div class="tools-catalog-search">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input
            type="search"
            placeholder="Filter tools by name or tag…"
            aria-label="Filter tools"
            data-tools-filter
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <div class="tools-catalog-scroll">
          <ul class="tools-card-grid tools-catalog-grid">
            {
              catalogTools.map((t) => (
                <li
                  data-tool-name={t.data.name.toLowerCase()}
                  data-tool-tag={t.data.tag.toLowerCase()}
                >
                  <a
                    href={`/playground/${t.id}`}
                    class={`tool-card tool-card-${t.data.tag.toLowerCase().replace(/\s+/g, '-')}`}
                  >
                    {t.data.thumbnail && (
                      <div class="tool-card-thumb">
                        {typeof t.data.thumbnail === 'string' ? (
                          <img src={t.data.thumbnail} alt="" loading="lazy" decoding="async" />
                        ) : (
                          <Image src={t.data.thumbnail} alt="" loading="lazy" />
                        )}
                      </div>
                    )}
                    <div class="tool-card-top">
                      {!t.data.thumbnail && (
                        <span class="tool-card-icon" aria-hidden="true">
                          {t.data.icon ?? '◇'}
                        </span>
                      )}
                      <span class="tool-card-tag">{t.data.tag}</span>
                    </div>
                    <h3 class="tool-card-name">{t.data.name}</h3>
                    <p class="tool-card-summary">{t.data.summary}</p>
                    <div class="tool-card-foot">
                      <span class="tool-card-link">Open tool →</span>
                    </div>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="tools-catalog-empty" data-tools-empty hidden>No tools match your filter.</div>
        </div>
      </div>
    </section>

    <section class="more-tools">
      <div class="more-tools-head">
        <div class="eyebrow">Around the web</div>
        <h2 class="more-tools-title">Canonical references.</h2>
      </div>

      <ul class="tools-card-grid">
        {
          EXTERNAL_TOOLS.map((t) => (
            <li>
              <a
                href={t.href}
                target="_blank"
                rel="noreferrer"
                class="tool-card tool-card-external"
              >
                <div class="tool-card-top">
                  <span class="tool-card-icon" aria-hidden="true">
                    ↗
                  </span>
                  <span class="tool-card-tag">{t.category}</span>
                </div>
                <h3 class="tool-card-name">{t.name}</h3>
                <p class="tool-card-summary">{t.desc}</p>
                <div class="tool-card-foot">
                  <span class="tool-card-link">{t.source}</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .more-tools {
    margin-top: 96px;
    padding-top: 56px;
    border-top: 1px solid var(--line);
  }
  .more-tools-head {
    margin-bottom: 40px;
    max-width: 720px;
  }
  .more-tools-title {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -1px;
    margin: 8px 0 12px;
    color: var(--ink);
  }
  .more-tools-lede {
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 0;
  }
  .more-tools-cta {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
  }
  .more-tools-cta:hover {
    border-color: var(--accent);
  }
  .more-tools-empty {
    padding: 48px 0;
    color: var(--ink-3);
    text-align: center;
    font-size: 15px;
  }
  .more-tools-empty a {
    color: var(--accent);
  }

  .tools-card-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .tools-card-grid li {
    display: block;
  }

  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px 24px 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-2);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }
  .tool-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.22s ease;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: var(--paper);
    box-shadow: 0 8px 24px -14px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .tool-card:hover::before {
    transform: scaleY(1);
  }
  .tool-card:hover .tool-card-link {
    color: var(--accent);
    transform: translateX(4px);
  }

  .tool-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .tool-card-icon {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--accent);
    line-height: 1;
  }
  .tool-card-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    padding: 3px 8px;
    border: 1px solid var(--line-2);
    border-radius: 99px;
  }
  .tool-card-live .tool-card-tag {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }
  .tool-card-beta .tool-card-tag {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tool-card-coming-soon .tool-card-tag {
    color: var(--ink-4);
  }
  .tool-card-name {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .tool-card-summary {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 20px;
    flex: 1;
  }
  .tool-card-foot {
    padding-top: 12px;
    border-top: 1px dashed var(--line);
  }
  .tool-card-link {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-block;
    transition:
      color 0.15s,
      transform 0.18s;
  }

  @media (max-width: 1000px) {
    .tools-card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .tools-card-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .more-tools-title {
      font-size: 32px;
    }
  }

  .tool-card-external .tool-card-tag {
    color: var(--ink-3);
    border-color: var(--line-2);
  }
  .tool-card-external:hover .tool-card-icon {
    transform: translate(2px, -2px);
    transition: transform 0.18s;
  }
  .tool-card-external .tool-card-link {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 11px;
  }

  .tools-catalog {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .tools-catalog-search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink-3);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .tools-catalog-search:focus-within {
    border-color: var(--accent);
    background: var(--paper);
  }
  .tools-catalog-search input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    padding: 4px 0;
    min-width: 0;
  }
  .tools-catalog-search input::placeholder {
    color: var(--ink-3);
  }
  .tools-catalog-search input::-webkit-search-cancel-button {
    appearance: none;
    -webkit-appearance: none;
  }

  .tools-catalog-scroll {
    max-height: 640px;
    overflow-y: auto;
    padding-right: 4px;
    scrollbar-width: thin;
  }
  .tools-catalog-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .tools-catalog-scroll::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: 3px;
  }
  .tools-catalog-empty {
    padding: 40px 0;
    text-align: center;
    color: var(--ink-3);
    font-size: 14px;
  }

  .tool-card-thumb {
    margin: -24px -24px 18px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--paper-3);
  }
  .tool-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 720px) {
    .tools-catalog-scroll {
      max-height: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tools-catalog]');
  const input = root?.querySelector<HTMLInputElement>('[data-tools-filter]');
  const items = root?.querySelectorAll<HTMLElement>('.tools-catalog-grid > li');
  const empty = root?.querySelector<HTMLElement>('[data-tools-empty]');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    items?.forEach((li) => {
      const name = li.dataset.toolName ?? '';
      const tag = li.dataset.toolTag ?? '';
      const match = !q || name.includes(q) || tag.includes(q);
      li.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>
