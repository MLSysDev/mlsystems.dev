---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Playground from '@/components/Playground.tsx';
import { TOOLS } from '@/lib/data';

const allTools = await getCollection('tools', ({ data }) => !data.draft);
const tools = allTools
  .filter((t) => !t.data.core)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return a.data.name.localeCompare(b.data.name);
  });
---

<BaseLayout
  title="Playground"
  description="Working calculators, visualizers, and benchmarks for ML systems work — throughput, attention, cost."
  image="/og/page/playground.png"
>
  <div class="container">
    <div class="page-head">
      <div class="eyebrow page-eyebrow">Playground</div>
      <h1 class="page-h1">Tools.</h1>
      <p class="page-lede">
        Working calculators, visualizers, and benchmarks for ML systems work. Open source, no auth,
        no telemetry. Pick a tool below.
      </p>
    </div>

    <Playground tools={TOOLS} client:visible />

    <section class="more-tools">
      <div class="more-tools-head">
        <div class="eyebrow">More from the community</div>
        <h2 class="more-tools-title">Standalone tools & demos.</h2>
        <p class="more-tools-lede">
          Want to add one? <a href="/contribute" class="more-tools-cta">Contribute a tool →</a>
        </p>
      </div>

      {
        tools.length === 0 ? (
          <div class="more-tools-empty">
            No standalone tools yet. <a href="/contribute">Be the first to contribute one.</a>
          </div>
        ) : (
          <ul class="tools-card-grid">
            {tools.map((t) => (
              <li>
                <a
                  href={`/playground/${t.id}`}
                  class={`tool-card tool-card-${t.data.tag.toLowerCase().replace(/\s+/g, '-')}`}
                >
                  <div class="tool-card-top">
                    <span class="tool-card-icon" aria-hidden="true">
                      {t.data.icon ?? '◇'}
                    </span>
                    <span class="tool-card-tag">{t.data.tag}</span>
                  </div>
                  <h3 class="tool-card-name">{t.data.name}</h3>
                  <p class="tool-card-summary">{t.data.summary}</p>
                  <div class="tool-card-foot">
                    <span class="tool-card-link">Open tool →</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .more-tools {
    margin-top: 96px;
    padding-top: 56px;
    border-top: 1px solid var(--line);
  }
  .more-tools-head {
    margin-bottom: 40px;
    max-width: 720px;
  }
  .more-tools-title {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -1px;
    margin: 8px 0 12px;
    color: var(--ink);
  }
  .more-tools-lede {
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.55;
    margin: 0;
  }
  .more-tools-cta {
    color: var(--accent);
    border-bottom: 1px solid var(--accent-soft);
  }
  .more-tools-cta:hover {
    border-color: var(--accent);
  }
  .more-tools-empty {
    padding: 48px 0;
    color: var(--ink-3);
    text-align: center;
    font-size: 15px;
  }
  .more-tools-empty a {
    color: var(--accent);
  }

  .tools-card-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .tools-card-grid li {
    display: block;
  }

  .tool-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px 24px 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-2);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease;
  }
  .tool-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.22s ease;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: var(--paper);
    box-shadow: 0 8px 24px -14px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .tool-card:hover::before {
    transform: scaleY(1);
  }
  .tool-card:hover .tool-card-link {
    color: var(--accent);
    transform: translateX(4px);
  }

  .tool-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .tool-card-icon {
    font-family: var(--font-mono);
    font-size: 22px;
    color: var(--accent);
    line-height: 1;
  }
  .tool-card-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    padding: 3px 8px;
    border: 1px solid var(--line-2);
    border-radius: 99px;
  }
  .tool-card-live .tool-card-tag {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }
  .tool-card-beta .tool-card-tag {
    color: var(--accent);
    border-color: var(--accent);
  }
  .tool-card-coming-soon .tool-card-tag {
    color: var(--ink-4);
  }
  .tool-card-name {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .tool-card-summary {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 20px;
    flex: 1;
  }
  .tool-card-foot {
    padding-top: 12px;
    border-top: 1px dashed var(--line);
  }
  .tool-card-link {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-block;
    transition:
      color 0.15s,
      transform 0.18s;
  }

  @media (max-width: 1000px) {
    .tools-card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .tools-card-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .more-tools-title {
      font-size: 32px;
    }
  }
</style>
