---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '@/lib/site';

const channels = [
  {
    label: 'Forum Discussions',
    blurb: 'Ask questions, share what you built, run a poll, or just discuss ML systems.',
    action: 'Open the Forum',
    href: '/forum',
    tag: 'asynchronous',
  },
  {
    label: 'Discord',
    blurb:
      'Real-time chat for the working day. Quick questions, debugging help, paper club, off-topic.',
    action: 'Join the server',
    href: SOCIALS.discord,
    tag: 'real-time',
  },
  {
    label: 'GitHub Issues',
    blurb: 'Found a bug on the site, a broken link, or a typo in an article? File it on the repo.',
    action: 'Report an issue',
    href: SITE.issuesUrl,
    tag: 'bug reports',
  },
  {
    label: 'X / Twitter',
    blurb: 'New articles, threads, and announcements. Follow for the firehose.',
    action: SITE.twitter,
    href: SOCIALS.twitter,
    tag: 'announcements',
  },
];
---

<BaseLayout
  title="Community"
  description="Where the ML Systems community talks. Forum Discussions for long-form, Discord for real-time chat."
  image="/og/page/community.png"
>
  <div class="container">
    <div class="page-head">
      <div class="eyebrow page-eyebrow">Discourse</div>
      <h1 class="page-h1">Community.</h1>
      <p class="page-lede">
        We're trying to build the comments section the field deserves — technical, kind,
        signal-rich. The discussion lives in the forum and on Discord. No karma, no algorithm, no
        ads.
      </p>
    </div>

    <div class="community-channels">
      {
        channels.map((c) => {
          const external = (c.href ?? '#').startsWith('http');
          return (
            <a
              href={c.href ?? '#'}
              target={external ? '_blank' : undefined}
              rel={external ? 'noreferrer' : undefined}
              class="card card--interactive community-channel"
            >
              <div class="community-channel-head">
                <h3>{c.label}</h3>
                <span class="community-channel-tag">{c.tag}</span>
              </div>
              <p>{c.blurb}</p>
              <span class="community-channel-action">
                {c.action} <span aria-hidden="true">→</span>
              </span>
            </a>
          );
        })
      }
    </div>

    <div class="side-panel" style="margin-top: 48px;">
      <h3 style="font-size: 22px; margin-bottom: 12px;">House rules</h3>
      <ol
        style="padding-left: 18px; font-size: 14px; color: var(--ink-2); line-height: 1.7; margin: 0;"
      >
        <li>Be specific. Vague questions get vague answers.</li>
        <li>Show your numbers. Benchmarks beat opinions.</li>
        <li>Cite, don't paraphrase. Link to the paper, the commit, the issue.</li>
        <li>Disagree on substance, never on identity.</li>
        <li>Help juniors. We were all juniors yesterday.</li>
      </ol>
    </div>
  </div>
</BaseLayout>

<style>
  .community-channels {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .community-channel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 24px 20px;
    border-radius: var(--radius-lg);
  }
  .community-channel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .community-channel-head h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }
  .community-channel-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .community-channel p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .community-channel-action {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  @media (max-width: 720px) {
    .community-channels {
      grid-template-columns: 1fr;
    }
  }
</style>
