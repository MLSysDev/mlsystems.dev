---
import { getCollection, getEntries, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { mdxComponents } from '@/components/MDXComponents.tsx';
import ArticleActions from '@/components/ArticleActions.tsx';
import Comments from '@/components/Comments.tsx';
import Avatar from '@/components/Avatar.astro';
import { formatDate, sortPostsByDate, topicName, tagSlug } from '@/lib/data';
import { SITE } from '@/lib/site';
import 'katex/dist/katex.min.css';

// Pre-build a page for every published post.
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content } = await render(post);

// Resolve author references → full author entries
const authors = await getEntries(post.data.authors);
const authorNames = authors.map((a) => a.data.name).join(', ');

// Related: same topic, sorted by date desc, skip self, take 3. Resolve their authors too.
const all = await getCollection('posts', ({ data }) => !data.draft);
const relatedRaw = all
  .filter((a) => a.data.topicId === post.data.topicId && a.id !== post.id)
  .sort(sortPostsByDate)
  .slice(0, 3);
const related = await Promise.all(
  relatedRaw.map(async (r) => ({ ...r, authors: await getEntries(r.data.authors) })),
);

const canonical = `${SITE.url}/blog/${post.id}`;
const dateISO = post.data.date.toISOString();
const modifiedISO = (post.data.updated ?? post.data.date).toISOString();
const topicLabel = topicName(post.data.topicId);
const cover = post.data.cover;
const ogImage = cover ? (typeof cover === 'string' ? cover : cover.src) : `/og/post/${post.id}.png`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.summary,
  image: new URL(ogImage, SITE.url).toString(),
  datePublished: dateISO,
  dateModified: modifiedISO,
  author: authors.map((a) => ({
    '@type': 'Person',
    name: a.data.name,
    url: `${SITE.url}/authors/${a.id}`,
  })),
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: new URL('/favicon-96x96.png', SITE.url).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: post.data.tags?.join(', '),
  articleSection: topicLabel,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: topicLabel,
      item: `${SITE.url}/topics/${post.data.topicId}`,
    },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  canonical={canonical}
  image={ogImage}
  ogType="article"
  publishedTime={dateISO}
  modifiedTime={modifiedISO}
  section={topicLabel}
  tags={post.data.tags}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <article
    class="article-shell"
    data-pagefind-body
    data-pagefind-meta={`topic:${topicName(post.data.topicId)}, date:${formatDate(dateISO)}, read:${post.data.readMin} min, authors:${authorNames}`}
  >
    <div class="article-head">
      <a href="/blog" class="article-back">← Back to archive</a>

      <div class="article-byline" style="margin-bottom: 4px;">
        <span
          style="padding: 2px 10px; border: 1px solid var(--line-2); border-radius: var(--radius-pill);"
          >{topicName(post.data.topicId)}</span
        >
        {
          post.data.tags?.map((t) => (
            <a href={`/tags/${tagSlug(t)}`} style="color: var(--ink-3); text-decoration: none;">
              #{t}
            </a>
          ))
        }
      </div>

      <h1 class="article-h1">{post.data.title}</h1>

      <p class="article-deck">{post.data.summary}</p>

      <div class="article-byline">
        <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
          {
            authors.map((a) => (
              <a
                href={`/authors/${a.id}`}
                style="display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none;"
              >
                <Avatar name={a.data.name} avatar={a.data.avatar} size={32} />
                <div>
                  <strong>{a.data.name}</strong>
                  <div style="font-size: 11px; color: var(--ink-3); margin-top: 2px;">
                    @{a.id} · {a.data.role}
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        <span style="color: var(--ink-4);">·</span>
        <span>{formatDate(dateISO)}</span>
        <span style="color: var(--ink-4);">·</span>
        <span>{post.data.readMin} min read</span>
      </div>
    </div>

    <div class="article-body">
      <Content components={mdxComponents} />
    </div>

    <ArticleActions
      client:visible
      title={post.data.title}
      author={authorNames}
      date={formatDate(dateISO)}
    />

    <div data-pagefind-ignore>
      <Comments client:visible />
    </div>

    {
      related.length > 0 && (
        <div class="comments" data-pagefind-ignore style="margin-top: 80px;">
          <h2 style="margin-bottom: 24px;">More from this topic</h2>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            {related.map((r) => (
              <a href={`/blog/${r.id}`} class="article-card" style="padding: 20px 0;">
                <div class="article-meta">
                  <span style="color: var(--ink-3);">{topicName(r.data.topicId)}</span>
                </div>
                <h3 class="article-title" style="font-size: 22px;">
                  {r.data.title}
                </h3>
                <div class="article-foot">
                  <span>{r.authors.map((a) => a.data.name).join(', ')}</span>
                  <span>
                    {formatDate(r.data.date.toISOString())} · {r.data.readMin} min
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </article>

  <script>
    const anchors = document.querySelectorAll<HTMLAnchorElement>(
      '.article-body :is(h1, h2, h3, h4) > a[href^="#"]',
    );
    anchors.forEach((a) => {
      a.setAttribute('title', 'Copy link');
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const hash = a.getAttribute('href');
        history.replaceState(null, '', hash);
        const flash = () => {
          a.classList.remove('is-copied');
          void a.offsetWidth;
          a.classList.add('is-copied');
          setTimeout(() => a.classList.remove('is-copied'), 700);
        };
        const url = location.origin + location.pathname + hash;
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(url).then(flash, flash);
        } else {
          flash();
        }
      });
    });

    const videoButtons = document.querySelectorAll<HTMLButtonElement>('.video-embed-play');
    videoButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-video-id');
        const iframe = document.createElement('iframe');
        iframe.className = 'video-embed-frame';
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
        iframe.title = 'YouTube video player';
        iframe.setAttribute(
          'allow',
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture',
        );
        iframe.allowFullscreen = true;
        btn.replaceWith(iframe);
      });
    });
  </script>
</BaseLayout>
