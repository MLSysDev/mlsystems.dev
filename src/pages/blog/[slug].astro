---
import { getCollection, getEntries, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { mdxComponents } from '@/components/MDXComponents.tsx';
import ArticleActions from '@/components/ArticleActions.tsx';
import Comments from '@/components/Comments.tsx';
import { formatDate, sortPostsByDate } from '@/lib/data';
import { SITE } from '@/lib/site';

// Pre-build a page for every published post.
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { Content } = await render(post);

// Resolve author references → full author entries
const authors = await getEntries(post.data.authors);
const authorNames = authors.map((a) => a.data.name).join(', ');

// Related: same topic, sorted by date desc, skip self, take 3. Resolve their authors too.
const all = await getCollection('posts', ({ data }) => !data.draft);
const relatedRaw = all
  .filter((a) => a.data.topicId === post.data.topicId && a.id !== post.id)
  .sort(sortPostsByDate)
  .slice(0, 3);
const related = await Promise.all(
  relatedRaw.map(async (r) => ({ ...r, authors: await getEntries(r.data.authors) })),
);

const canonical = `${SITE.url}/blog/${post.id}`;
const dateISO = post.data.date.toISOString();
const cover = post.data.cover;
const ogImage = cover ? (typeof cover === 'string' ? cover : cover.src) : `/og/post/${post.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: dateISO,
  author: authors.map((a) => ({ '@type': 'Person', name: a.data.name })),
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: post.data.tags?.join(', '),
  articleSection: post.data.topic,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  canonical={canonical}
  image={ogImage}
  ogType="article"
  publishedTime={dateISO}
  jsonLd={jsonLd}
>
  <article
    class="article-shell"
    data-pagefind-body
    data-pagefind-meta={`topic:${post.data.topic}, date:${formatDate(dateISO)}, read:${post.data.readMin} min, authors:${authorNames}`}
  >
    <div class="article-head">
      <a href="/blog" class="article-back">← Back to archive</a>

      <div class="article-byline" style="margin-bottom: 4px;">
        <span style="padding: 2px 10px; border: 1px solid var(--line-2); border-radius: 99px;"
          >{post.data.topic}</span
        >
        {post.data.tags?.map((t) => <span style="color: var(--ink-3);">#{t}</span>)}
      </div>

      <h1 class="article-h1">{post.data.title}</h1>

      <p
        style="font-family: var(--font-display); font-style: italic; font-size: 22px; color: var(--ink-2); line-height: 1.4; margin: 0 0 32px; max-width: 720px;"
      >
        {post.data.summary}
      </p>

      <div class="article-byline">
        <div style="display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
          {
            authors.map((a) => (
              <a
                href={`/authors/${a.id}`}
                style="display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none;"
              >
                <div class="comment-avatar" style="width: 32px; height: 32px; font-size: 12px;">
                  {a.data.name
                    .split(' ')
                    .map((w) => w[0])
                    .join('')}
                </div>
                <div>
                  <strong>{a.data.name}</strong>
                  <div style="font-size: 11px; color: var(--ink-3); margin-top: 2px;">
                    @{a.id} · {a.data.role}
                  </div>
                </div>
              </a>
            ))
          }
        </div>
        <span style="color: var(--ink-4);">·</span>
        <span>{formatDate(dateISO)}</span>
        <span style="color: var(--ink-4);">·</span>
        <span>{post.data.readMin} min read</span>
      </div>
    </div>

    <div class="article-body">
      <Content components={mdxComponents} />
    </div>

    <ArticleActions
      client:visible
      title={post.data.title}
      author={authorNames}
      date={formatDate(dateISO)}
    />

    <div data-pagefind-ignore>
      <Comments client:visible />
    </div>

    {
      related.length > 0 && (
        <div class="comments" data-pagefind-ignore style="margin-top: 80px;">
          <h2 style="margin-bottom: 24px;">More from this topic</h2>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            {related.map((r) => (
              <a href={`/blog/${r.id}`} class="article-card" style="padding: 20px 0;">
                <div class="article-meta">
                  <span style="color: var(--ink-3);">{r.data.topic}</span>
                </div>
                <h3 class="article-title" style="font-size: 22px;">
                  {r.data.title}
                </h3>
                <div class="article-foot">
                  <span>{r.authors.map((a) => a.data.name).join(', ')}</span>
                  <span>
                    {formatDate(r.data.date.toISOString())} · {r.data.readMin} min
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
