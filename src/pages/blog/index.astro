---
import { getCollection, getEntries } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogFilter from '@/components/BlogFilter.astro';
import { TOPICS, formatDate, formatMonth, sortPostsByDate } from '@/lib/data';

const url = new URL(Astro.request.url);
const activeTopic = url.searchParams.get('topic') || 'all';

const allRaw = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortPostsByDate);

// Resolve author references for each post so we can render names without async in templates
const all = await Promise.all(
  allRaw.map(async (p) => ({ ...p, authors: await getEntries(p.data.authors) })),
);

// Per-topic counts for the filter chips
const topicCounts: Record<string, number> = {};
TOPICS.forEach((t) => {
  topicCounts[t.id] = all.filter((p) => p.data.topicId === t.id).length;
});

// Group by month for display
const grouped: Record<string, typeof all> = {};
all.forEach((a) => {
  const m = formatMonth(a.data.date.toISOString());
  if (!grouped[m]) grouped[m] = [];
  grouped[m].push(a);
});
---

<BaseLayout
  title="All articles"
  description="The complete archive of ML Systems articles — long-form writing on inference, training, architecture, quantization, RAG, and more."
  image="/og/page/blog.png"
>
  <div class="container blog-shell">
    <div class="blog-head">
      <div>
        <div class="eyebrow page-eyebrow">The Archive</div>
        <h1 class="blog-h1">All articles.</h1>
      </div>
    </div>

    <BlogFilter activeTopic={activeTopic} allCount={all.length} topicCounts={topicCounts} />

    {
      Object.entries(grouped).map(([month, items]) => (
        <div class="blog-month-group" style="margin-bottom: 40px;">
          <div class="eyebrow" style="margin-bottom: 4px; color: var(--ink-3);">
            {month}
          </div>
          <div class="blog-list">
            {items.map((a) => (
              <a href={`/blog/${a.id}`} class="blog-row" data-topic={a.data.topicId}>
                <div class="blog-row-body">
                  <div class="blog-row-title-line">
                    <h3 class="blog-row-title">{a.data.title}</h3>
                    <span class="blog-row-chip">{a.data.topic}</span>
                    {a.data.tags?.slice(0, 2).map((t) => (
                      <span class="blog-row-tag">#{t}</span>
                    ))}
                  </div>
                  <p class="blog-row-summary">{a.data.summary}</p>
                </div>
                <div class="blog-row-meta">
                  <strong>{a.authors.map((au) => au.data.name).join(' · ')}</strong>
                  <span>{formatDate(a.data.date.toISOString())}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))
    }

    <div
      id="blog-empty"
      style="display: none; padding: 80px 0; text-align: center; color: var(--ink-3);"
    >
      No articles in this topic yet. Be the first to{' '}
      <a href="/contribute" style="color: var(--accent);">write one</a>.
    </div>
  </div>
</BaseLayout>

<!--
  Client-side filtering: we ship a tiny ~700-byte script that toggles row
  visibility based on ?topic=. No React, no hydration cost — this is the
  Astro advantage.
-->
<script>
  function applyFilter() {
    const params = new URLSearchParams(window.location.search);
    const topic = params.get('topic') || 'all';
    const rows = document.querySelectorAll<HTMLElement>('.blog-row');
    let visibleCount = 0;
    rows.forEach((r) => {
      const matches = topic === 'all' || r.dataset.topic === topic;
      r.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
    });
    document.querySelectorAll<HTMLElement>('.blog-month-group').forEach((g) => {
      const anyVisible =
        g.querySelectorAll<HTMLElement>('.blog-row').length > 0 &&
        Array.from(g.querySelectorAll<HTMLElement>('.blog-row')).some(
          (r) => r.style.display !== 'none',
        );
      g.style.display = anyVisible ? '' : 'none';
    });
    const empty = document.getElementById('blog-empty');
    if (empty) empty.style.display = visibleCount === 0 ? '' : 'none';
  }
  applyFilter();
  window.addEventListener('popstate', applyFilter);
</script>
