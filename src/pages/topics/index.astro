---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { TOPICS, countPostsByTopic } from '@/lib/topics';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const topicCounts = countPostsByTopic(posts);
const visibleTopics = TOPICS.filter((t) => (topicCounts[t.id] ?? 0) > 0);
---

<BaseLayout
  title="Topics"
  description="Browse the ML Systems archive by topic — inference, training, architecture, quantization, RAG, and more."
  image="/og/page/topics.png"
>
  <div class="container">
    <div class="page-head">
      <div class="eyebrow page-eyebrow">The Index</div>
      <h1 class="page-h1">Topics.</h1>
      <p class="page-lede">
        Explore the ideas, systems, and engineering problems behind modern ML infrastructure.
      </p>
    </div>

    <div class="topics-list" style="margin-top: 16px;">
      {
        visibleTopics.map((t, i) => (
          <a href={`/topics/${t.id}`} class="topic-row">
            <span class="topic-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="topic-name">{t.name}</h3>
            <span class="topic-desc">{t.desc}</span>
            <span class="topic-count">
              {topicCounts[t.id]} {topicCounts[t.id] === 1 ? 'article' : 'articles'}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
