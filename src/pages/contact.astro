---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '@/lib/site';
import { SOCIAL_ICONS } from '@/lib/socialIcons';

const channels = [
  {
    label: 'Discord',
    icon: SOCIAL_ICONS.discord.path,
    title: 'Meet the community',
    description: 'Talk ML systems, share what you’re building, and learn with others.',
    href: SOCIALS.discord,
  },
  {
    label: 'Forum',
    icon: '',
    title: 'Open a discussion',
    description: 'Ask a technical question or leave an idea others can build on.',
    href: '/forum',
  },
  {
    label: 'GitHub',
    icon: SOCIAL_ICONS.github.path,
    title: 'Help improve the site',
    description: 'Found a bug or something we should change? Tell us about it.',
    href: SITE.issuesUrl,
  },
];
---

<BaseLayout
  title="Contact"
  description="An article idea, a question, or a way to make ML Systems better. Get in touch or find the community on Discord and the forum."
  image="/og/page/contact.png"
>
  <div class="container contact-page">
    <header class="contact-intro">
      <div class="contact-heading">
        <p class="eyebrow">Get in touch</p>
        <h1>What’s on<br /><em>your mind?</em></h1>
      </div>
      <div class="contact-welcome">
        <svg class="conversation-art" viewBox="0 0 240 160" fill="none" aria-hidden="true">
          <path class="conversation-thread" d="M54 57C54 15 191 12 191 110"></path>
          <path
            class="conversation-bubble"
            d="M29 36H126A14 14 0 0 1 140 50V87A14 14 0 0 1 126 101H67L43 120V101H29A14 14 0 0 1 15 87V50A14 14 0 0 1 29 36Z"
          ></path>
          <path
            class="conversation-reply"
            d="M129 79H207A12 12 0 0 1 219 91V119A12 12 0 0 1 207 131H196V145L177 131H129A12 12 0 0 1 117 119V91A12 12 0 0 1 129 79Z"
          ></path>
          <g class="conversation-dots">
            <circle cx="55" cy="69" r="3"></circle><circle cx="77" cy="69" r="3"></circle><circle
              cx="99"
              cy="69"
              r="3"></circle>
          </g>
          <path class="conversation-line" d="M140 104H192"></path>
          <circle class="conversation-node" cx="191" cy="28" r="4"></circle>
        </svg>
        <p class="contact-lede">
          An article idea, a question, or a way to make this community better. We’d like to hear it.
        </p>
        <a class="contact-email" href={`mailto:${SITE.pitchEmail}`}>
          <span>{SITE.pitchEmail}</span><span aria-hidden="true">↗</span>
        </a>
        <p class="contact-writing">
          Ready to share something? <a href="/contribute">Write with us.</a>
        </p>
        <div class="contact-socials" aria-label="Social channels">
          <a href={SOCIALS.twitter} aria-label="ML Systems on X">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
              <path d={SOCIAL_ICONS.twitter.path}></path>
            </svg>
            <span class="social-arrow" aria-hidden="true">↗</span>
          </a>
          <a href={SOCIALS.linkedin} aria-label="ML Systems on LinkedIn">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
              <path d={SOCIAL_ICONS.linkedin.path}></path>
            </svg>
            <span>LinkedIn</span><span class="social-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </header>

    <section class="contact-community" aria-labelledby="contact-community-title">
      <div class="contact-section-heading">
        <h2 id="contact-community-title">Around the community</h2>
        <p>Join in wherever you feel at home.</p>
      </div>
      <div class="contact-channels">
        {
          channels.map((channel) => (
            <a class="contact-channel" href={channel.href}>
              <span class="contact-channel-label eyebrow">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  {channel.icon ? (
                    <path fill="currentColor" d={channel.icon} />
                  ) : (
                    <path
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 4h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-8l-6 4v-4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM7 9h10M7 13h6"
                    />
                  )}
                </svg>
                {channel.label}
              </span>
              <span class="contact-channel-title">
                {channel.title}
                <span aria-hidden="true">↗</span>
              </span>
              <span class="contact-channel-description">{channel.description}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-intro {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(48px, 8vw, 112px);
    padding: 48px 0;
    border-bottom: 1px solid var(--line-2);
  }
  .contact-intro::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -24px -24px 0;
    background: radial-gradient(
      ellipse at 65% 40%,
      color-mix(in srgb, var(--accent) 5%, transparent),
      transparent 68%
    );
    pointer-events: none;
  }
  .contact-heading {
    align-self: start;
    padding: 24px 0 0;
  }
  .contact-heading .eyebrow {
    margin: 0 0 24px;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(64px, 7vw, 100px);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.06;
  }
  h1 em {
    color: var(--accent);
    font-weight: 400;
  }
  .contact-welcome {
    max-width: 460px;
  }
  .conversation-art {
    display: block;
    width: 160px;
    height: auto;
    margin: 0 0 20px auto;
  }
  .conversation-thread {
    stroke: var(--line-2);
    stroke-dasharray: 3 5;
  }
  .conversation-bubble,
  .conversation-reply {
    fill: var(--paper);
    stroke: var(--accent);
    stroke-width: 1.4;
  }
  .conversation-reply {
    fill: var(--paper-2);
  }
  .conversation-dots,
  .conversation-node {
    fill: var(--accent);
  }
  .conversation-dots circle {
    animation: conversation-dot 2.4s ease-in-out infinite;
  }
  .conversation-dots circle:nth-child(2) {
    animation-delay: 0.2s;
  }
  .conversation-dots circle:nth-child(3) {
    animation-delay: 0.4s;
  }
  .conversation-line {
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  @keyframes conversation-dot {
    0%,
    65%,
    100% {
      opacity: 0.4;
    }
    30% {
      opacity: 1;
    }
  }
  .contact-lede {
    font-family: var(--font-read);
    font-size: 23px;
    line-height: 1.55;
    color: var(--ink-2);
    margin: 0 0 28px;
  }
  .contact-email {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding: 0 0 14px;
    border-bottom: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(22px, 2.5vw, 30px);
  }
  .contact-email:hover {
    color: var(--ink);
  }
  .contact-writing {
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.7;
    margin: 20px 0 0;
  }
  .contact-writing a {
    color: var(--accent);
    text-underline-offset: 4px;
    text-decoration: underline;
  }
  .contact-community {
    padding: 36px 0 24px;
  }
  .contact-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    margin-bottom: 32px;
  }
  h2 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0;
  }
  .contact-section-heading p {
    color: var(--ink-3);
    font-size: 14px;
    margin: 0;
  }
  .contact-channels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
  }
  .contact-channel {
    display: block;
    position: relative;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .contact-channel::before {
    content: '';
    position: absolute;
    inset: -1px -12px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 8px;
    opacity: 0;
    transition: opacity 160ms ease;
    pointer-events: none;
  }
  .contact-channel:hover::before,
  .contact-channel:focus-visible::before {
    opacity: 1;
  }
  .contact-channel-label {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .contact-channel-label svg {
    color: var(--accent);
    flex-shrink: 0;
  }
  .contact-channel .eyebrow {
    color: var(--ink-3);
    font-size: 10px;
  }
  .contact-channel-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 18px;
    margin: 16px 0 10px;
    color: var(--ink);
  }
  .contact-channel:hover .contact-channel-title {
    color: var(--accent);
  }
  .contact-channel-description {
    display: block;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.7;
    max-width: 320px;
  }
  .contact-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }
  .contact-socials a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--line-2);
    border-radius: 6px;
    font-size: 13px;
    color: var(--ink-2);
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }
  .contact-socials a:hover,
  .contact-socials a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .social-arrow {
    margin-left: 8px;
  }
  @media (max-width: 760px) {
    .contact-intro {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 32px 0;
    }
    .contact-heading {
      padding: 0;
    }
    .contact-heading .eyebrow {
      margin-bottom: 16px;
    }
    h1 {
      font-size: clamp(46px, 9vw, 60px);
    }
    .conversation-art {
      display: none;
    }
    .contact-lede {
      font-size: 18px;
      line-height: 1.5;
      margin-bottom: 20px;
    }
    .contact-email {
      padding-bottom: 12px;
    }
    .contact-writing {
      margin-top: 14px;
    }
    .contact-socials {
      margin-top: 12px;
    }
    .contact-welcome {
      max-width: 520px;
    }
    .contact-section-heading {
      display: block;
      margin-bottom: 20px;
    }
    .contact-section-heading h2 {
      font-size: 28px;
      line-height: 1.2;
    }
    .contact-section-heading p {
      margin-top: 8px;
      font-size: 13px;
    }
    .contact-channels {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .contact-channel {
      display: grid;
      grid-template-columns: 90px minmax(0, 1fr);
      align-items: center;
      gap: 8px 16px;
      padding: 18px 0;
    }
    .contact-channel-label {
      gap: 8px;
    }
    .contact-channel .eyebrow {
      font-size: 9px;
    }
    .contact-channel-title {
      margin: 0;
      font-size: 16px;
      line-height: 1.4;
    }
    .contact-channel-title > span {
      flex-shrink: 0;
    }
    .contact-channel-description {
      grid-column: 1 / -1;
      max-width: none;
      font-size: 13px;
      line-height: 1.6;
    }
    .contact-community {
      padding-top: 28px;
    }
  }
  @media (min-width: 480px) and (max-width: 760px) {
    .contact-heading {
      padding-right: calc(clamp(120px, 23vw, 160px) + 20px);
    }
    .conversation-art {
      display: block;
      position: absolute;
      width: clamp(120px, 23vw, 160px);
      top: 76px;
      right: 0;
      margin: 0;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .conversation-dots circle {
      animation: none;
      opacity: 0.7;
    }
    .contact-channel::before,
    .contact-socials a {
      transition: none;
    }
  }
</style>
