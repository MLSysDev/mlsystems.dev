---
interface Props {
  name: string;
  avatar?: string;
  size?: number;
}
const { name, avatar, size = 40 } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<div class="avatar" style={`--avatar-size:${size}px`} aria-hidden="true">
  {avatar ? <img src={avatar} alt="" loading="lazy" decoding="async" /> : <span>{initials}</span>}
</div>

<style>
  .avatar {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: var(--radius-circle);
    overflow: hidden;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-3);
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: calc(var(--avatar-size) * 0.36);
    line-height: 1;
    letter-spacing: 0.01em;
    user-select: none;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
