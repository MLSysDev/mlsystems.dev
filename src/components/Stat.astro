---
interface Props {
  value: number | string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="stat">
  <div class="stat-value">{value}</div>
  <div class="stat-label">{label}</div>
</div>

<style>
  .stat-value {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
    color: var(--ink);
  }
  .stat-label {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-3);
  }
</style>
