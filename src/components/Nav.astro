---
import { TOPICS } from '@/lib/topics';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

const LINKS = [
  { id: 'blog', label: 'Articles', path: '/blog' },
  { id: 'topics', label: 'Topics', path: '/topics' },
  { id: 'playground', label: 'Playground', path: '/playground' },
  { id: 'forum', label: 'Forum', path: '/forum' },
];

const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---

<nav class="nav" id="site-nav" aria-label="Main navigation">
  <div class="nav-inner">
    <a href="/" class="brand">
      <span class="brand-mark"></span>
      <span>ML Systems</span>
    </a>

    <div class="nav-right">
      <div class="nav-links" id="nav-menu">
        {
          LINKS.map((l) =>
            l.id === 'topics' ? (
              <div class="nav-topics" data-topics-disclosure>
                <div class="nav-topics-heading">
                  <a
                    href={l.path}
                    class={isActive(l.path) ? 'active' : ''}
                    aria-current={currentPath === l.path ? 'page' : undefined}
                  >
                    {l.label}
                  </a>
                  <button
                    type="button"
                    class="nav-topics-toggle"
                    aria-label="Browse topics"
                    aria-expanded="false"
                    aria-controls="nav-topic-list"
                    data-topics-toggle
                  >
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      aria-hidden="true"
                    >
                      <path d="m4 6 4 4 4-4" />
                    </svg>
                  </button>
                </div>
                <div class="nav-topic-list" id="nav-topic-list" hidden>
                  <a class="nav-topics-overview" href="/topics">
                    Explore all topics <span aria-hidden="true">↗</span>
                  </a>
                  <div class="nav-topic-grid">
                    {TOPICS.map((topic) => (
                      <a
                        href={`/topics/${topic.id}`}
                        aria-current={isActive(`/topics/${topic.id}`) ? 'page' : undefined}
                      >
                        <span class="nav-topic-name">{topic.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={l.path}
                class={isActive(l.path) ? 'active' : ''}
                aria-current={isActive(l.path) ? 'page' : undefined}
              >
                {l.label}
              </a>
            ),
          )
        }
        <a href="/write" class="nav-mobile-write">Write an article</a>
      </div>

      <a href="/write" class="nav-write">
        <svg
          viewBox="0 0 24 24"
          width="13"
          height="13"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
        </svg>
        Write
      </a>

      <button
        type="button"
        class="nav-search"
        aria-label="Search the archive"
        title="Search (⌘K)"
        data-search-trigger
      >
        <svg
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="nav-search-label">Search</span>
        <kbd class="nav-search-kbd">⌘K</kbd>
      </button>

      <button
        type="button"
        class="theme-toggle"
        aria-label="Dark theme"
        aria-pressed="false"
        title="Toggle theme"
        data-theme-toggle
      >
        <svg
          class="theme-icon theme-icon-sun"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path>
        </svg>
        <svg
          class="theme-icon theme-icon-moon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
      </button>

      <button
        type="button"
        class="nav-burger"
        aria-label="Toggle navigation menu"
        aria-controls="nav-menu"
        aria-expanded="false"
        data-nav-toggle
      >
        <span class="nav-burger-bar"></span>
        <span class="nav-burger-bar"></span>
        <span class="nav-burger-bar"></span>
      </button>
    </div>
  </div>
</nav>

<script>
  import { writePrefs } from '@/lib/prefs';

  const nav = document.getElementById('site-nav');
  const toggle = nav?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const topics = nav?.querySelector<HTMLElement>('[data-topics-disclosure]');
  const topicsToggle = nav?.querySelector<HTMLButtonElement>('[data-topics-toggle]');
  const topicsList = nav?.querySelector<HTMLElement>('#nav-topic-list');
  let topicCloseTimer: ReturnType<typeof setTimeout> | undefined;
  const desktopHover = window.matchMedia(
    '(min-width: 901px) and (hover: hover) and (pointer: fine)',
  );
  const setTopicsOpen = (open: boolean) => {
    clearTimeout(topicCloseTimer);
    if (!topicsToggle || !topicsList) return;
    topicsToggle.setAttribute('aria-expanded', String(open));
    topicsList.hidden = !open;
  };
  topics?.addEventListener('pointerenter', (event) => {
    if (event.pointerType === 'mouse' && desktopHover.matches) setTopicsOpen(true);
  });
  topics?.addEventListener('pointerleave', (event) => {
    if (event.pointerType !== 'mouse' || !desktopHover.matches) return;
    topicCloseTimer = setTimeout(() => {
      if (
        !topics.contains(document.activeElement) ||
        !document.activeElement?.matches(':focus-visible')
      )
        setTopicsOpen(false);
    }, 180);
  });
  desktopHover.addEventListener('change', () => setTopicsOpen(false));
  topicsToggle?.addEventListener('click', () => setTopicsOpen(topicsList?.hidden ?? true));
  topicsToggle?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setTopicsOpen(true);
      topicsList?.querySelector<HTMLAnchorElement>('a')?.focus();
    }
  });
  topics?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !topicsList?.hidden) {
      event.preventDefault();
      setTopicsOpen(false);
      topicsToggle?.focus();
    }
  });
  topics?.addEventListener('focusout', (event) => {
    if (!topics.contains(event.relatedTarget as Node | null)) setTopicsOpen(false);
  });
  document.addEventListener('click', (event) => {
    if (!topics?.contains(event.target as Node)) setTopicsOpen(false);
  });

  toggle?.addEventListener('click', () => {
    setTopicsOpen(false);
    const open = nav!.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav?.querySelectorAll('.nav-links a').forEach((a) => {
    a.addEventListener('click', () => {
      setTopicsOpen(false);
      nav.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  const searchBtn = nav?.querySelector<HTMLButtonElement>('[data-search-trigger]');
  searchBtn?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('mls:open-search'));
  });

  const themeBtn = nav?.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const reflectTheme = () => {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    themeBtn?.setAttribute('aria-pressed', String(dark));
  };
  reflectTheme();
  themeBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    const themeColor = document.querySelector('meta[name="theme-color"]');
    if (themeColor) themeColor.setAttribute('content', next === 'dark' ? '#0e0d0b' : '#f6f2e9');
    reflectTheme();
    writePrefs({ theme: next });
  });
</script>
