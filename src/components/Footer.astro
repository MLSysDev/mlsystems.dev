---
import { SITE, SOCIALS } from '@/lib/site';
import { SOCIAL_ICONS } from '@/lib/socialIcons';
const currentYear = new Date().getFullYear();

const socialIcons = (['discord', 'github', 'twitter', 'linkedin'] as const).map((key) => ({
  key,
  label: SOCIAL_ICONS[key].label,
  path: SOCIAL_ICONS[key].path,
  href: SOCIALS[key],
}));
---

<footer class="footer">
  <div class="container">
    <div class="footer-body">
      <div class="footer-brand-row">
        <a href="/" class="brand" style="font-size: 28px; display: inline-flex;">
          <span class="brand-mark"></span>
          <span>{SITE.name}</span>
        </a>
        <p class="footer-tagline">
          An open archive for the engineers and researchers building modern machine learning
          systems.
        </p>
        <ul class="footer-socials-icons">
          {
            socialIcons.map((s) => (
              <li>
                {s.href ? (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={s.label}
                    title={s.label}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={s.path} />
                    </svg>
                  </a>
                ) : (
                  <span
                    class="social-disabled"
                    aria-label={`${s.label} — coming soon`}
                    title={`${s.label} — coming soon`}
                    aria-disabled="true"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={s.path} />
                    </svg>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-links-row">
        <div class="footer-col">
          <h2>Read</h2>
          <ul>
            <li><a href="/blog">All articles</a></li>
            <li><a href="/authors">Authors</a></li>
            <li><a href="/topics">Topics</a></li>
            <li><a href="/tags">Tags</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2>Participate</h2>
          <ul>
            <li><a href="/community">Community</a></li>
            <li><a href="/contribute">Contribute</a></li>
            <li><a href="/playground">Playground</a></li>
            <li><a href={SITE.github} target="_blank" rel="noreferrer">GitHub</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2>Connect</h2>
          <ul>
            <li><a href="/about">About us</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/content-policy">Content policy</a></li>
            <li><a href="/contact">Contact Us</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {currentYear} {SITE.name}</span>
      <span>Made by the community, for the community.</span>
    </div>
  </div>
</footer>
