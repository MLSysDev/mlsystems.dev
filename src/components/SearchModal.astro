---
import { TOPICS } from '@/lib/topics';

const HINT_TERMS = ['attention', 'quantization', 'vLLM', 'FSDP', 'evals'];
---

<!-- Topics for the client-side quick matcher — collections aren't readable in the browser. -->
<script type="application/json" data-search-topics set:html={JSON.stringify(TOPICS)} />

<div
  class="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
  data-search-modal
  hidden
>
  <button type="button" class="search-backdrop" aria-label="Close search" data-search-close
  ></button>
  <div class="search-panel">
    <div class="search-input-row">
      <svg
        class="search-icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        type="search"
        placeholder="Search articles, topics, ideas…"
        aria-label="Search the archive"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <button type="button" class="search-clear" aria-label="Clear search" data-search-clear hidden>
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="search-body">
      <div class="search-empty search-hint" data-search-idle>
        <div class="search-section">
          <div class="search-section-label">Browse by topic</div>
          <div class="search-topic-chips">
            {
              TOPICS.map((t) => (
                <a href={`/topics/${t.id}`} class="chip chip--interactive">
                  {t.name}
                </a>
              ))
            }
          </div>
        </div>
        <div class="search-section">
          <div class="search-section-label">Try searching</div>
          <div class="search-hint-terms">
            {
              HINT_TERMS.map((t) => (
                <button type="button" class="chip chip--interactive" data-search-term>
                  {t}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="search-empty" data-search-loading hidden>Searching…</div>

      <div class="search-empty" data-search-none hidden>
        No matches for <strong data-search-none-query></strong>.
        <a href="/blog">Browse the archive →</a>
      </div>

      <ul class="search-results" data-search-results hidden></ul>
    </div>

    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
      <a href="/search" class="search-foot-link">Full search →</a>
    </div>
  </div>
</div>

<script>
  import { loadPagefind } from '@/lib/pagefind';

  const TOPICS: { id: string; name: string; desc: string }[] = JSON.parse(
    document.querySelector('[data-search-topics]')?.textContent ?? '[]',
  );

  type Group = 'topic' | 'article' | 'tool' | 'author' | 'page';
  type RowItem = { group: Group; url: string; title: string; excerpt?: string; meta?: string };

  const GROUP_ORDER: Group[] = ['topic', 'article', 'tool', 'author', 'page'];
  const GROUP_LABEL: Record<Group, string> = {
    topic: 'Topics',
    article: 'Articles',
    tool: 'Tools',
    author: 'Authors',
    page: 'Pages',
  };

  function classifyUrl(url: string): Group {
    if (url.startsWith('/blog/')) return 'article';
    if (url.startsWith('/playground/')) return 'tool';
    if (url.startsWith('/authors/')) return 'author';
    return 'page';
  }

  const modalEl = document.querySelector<HTMLElement>('[data-search-modal]');
  if (modalEl) setup(modalEl);

  function setup(modal: HTMLElement) {
    const input = modal.querySelector<HTMLInputElement>('[data-search-input]')!;
    const clearBtn = modal.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    const idleEl = modal.querySelector<HTMLElement>('[data-search-idle]')!;
    const loadingEl = modal.querySelector<HTMLElement>('[data-search-loading]')!;
    const noneEl = modal.querySelector<HTMLElement>('[data-search-none]')!;
    const noneQueryEl = modal.querySelector<HTMLElement>('[data-search-none-query]')!;
    const resultsEl = modal.querySelector<HTMLUListElement>('[data-search-results]')!;

    let rows: RowItem[] = [];
    let activeIdx = 0;
    let searchSeq = 0;
    let loading = false;

    const isOpen = () => !modal.hidden;

    function open() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 30);
    }

    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
      input.value = '';
      rows = [];
      activeIdx = 0;
      render('');
    }

    function topicMatches(q: string): RowItem[] {
      return TOPICS.filter(
        (t) => t.name.toLowerCase().includes(q) || t.desc.toLowerCase().includes(q),
      )
        .slice(0, 3)
        .map((t) => ({
          group: 'topic' as const,
          url: `/topics/${t.id}`,
          title: t.name,
          excerpt: t.desc,
        }));
    }

    function render(query: string) {
      clearBtn.hidden = !query;
      idleEl.hidden = !!query;
      loadingEl.hidden = !(query && loading && rows.length === 0);
      const showNone = !!query && !loading && rows.length === 0;
      noneEl.hidden = !showNone;
      if (showNone) noneQueryEl.textContent = query;
      resultsEl.hidden = rows.length === 0;

      resultsEl.textContent = '';
      rows.forEach((row, i) => {
        const li = document.createElement('li');
        if (i === activeIdx) li.classList.add('active');

        const prev = rows[i - 1];
        if (!prev || prev.group !== row.group) {
          const label = document.createElement('div');
          label.className = 'search-group-label';
          label.setAttribute('aria-hidden', 'true');
          label.textContent = GROUP_LABEL[row.group];
          li.appendChild(label);
        }

        const a = document.createElement('a');
        a.href = row.url;
        if (row.meta) {
          const meta = document.createElement('div');
          meta.className = 'search-result-meta';
          const span = document.createElement('span');
          span.textContent = row.meta;
          meta.appendChild(span);
          a.appendChild(meta);
        }
        const title = document.createElement('div');
        title.className = 'search-result-title';
        title.innerHTML = row.title;
        a.appendChild(title);
        if (row.excerpt) {
          const excerpt = document.createElement('div');
          excerpt.className = 'search-result-excerpt';
          excerpt.innerHTML = row.excerpt;
          a.appendChild(excerpt);
        }
        li.appendChild(a);
        resultsEl.appendChild(li);
      });
    }

    function setActive(idx: number) {
      activeIdx = idx;
      resultsEl.querySelectorAll('li').forEach((li, i) => {
        li.classList.toggle('active', i === idx);
      });
      (resultsEl.children[idx] as HTMLElement | undefined)?.scrollIntoView({ block: 'nearest' });
    }

    async function search(query: string) {
      const seq = ++searchSeq;
      const q = query.trim().toLowerCase();
      if (!q) {
        rows = [];
        loading = false;
        render(query);
        return;
      }
      loading = true;
      render(query);
      try {
        const pf = await loadPagefind();
        const res = await pf.debouncedSearch(query);
        if (seq !== searchSeq || !res) return;
        const data = await Promise.all(res.results.slice(0, 10).map((r) => r.data()));
        if (seq !== searchSeq) return;
        const fromPagefind: RowItem[] = data.map((r) => ({
          group: classifyUrl(r.url),
          url: r.url,
          title: r.meta.title ?? r.url,
          excerpt: r.excerpt,
          meta: [r.meta.topic, r.meta.read].filter(Boolean).join(' · '),
        }));
        rows = [...topicMatches(q), ...fromPagefind].sort(
          (a, b) => GROUP_ORDER.indexOf(a.group) - GROUP_ORDER.indexOf(b.group),
        );
        activeIdx = 0;
      } catch {
        if (seq !== searchSeq) return;
        rows = topicMatches(q);
      } finally {
        if (seq === searchSeq) {
          loading = false;
          render(query);
        }
      }
    }

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (isOpen()) close();
        else open();
      } else if (e.key === '/' && !isOpen()) {
        const t = e.target as HTMLElement | null;
        const tag = t?.tagName;
        if (tag !== 'INPUT' && tag !== 'TEXTAREA' && !t?.isContentEditable) {
          e.preventDefault();
          open();
        }
      } else if (e.key === 'Escape' && isOpen()) {
        close();
      }
    });

    document.addEventListener('mls:open-search', open);

    modal.querySelector('[data-search-close]')?.addEventListener('click', close);

    input.addEventListener('input', () => search(input.value));

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(Math.min(activeIdx + 1, rows.length - 1));
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(Math.max(activeIdx - 1, 0));
      } else if (e.key === 'Enter' && rows[activeIdx]) {
        e.preventDefault();
        window.location.href = rows[activeIdx].url;
      }
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      search('');
      input.focus();
    });

    modal.querySelectorAll<HTMLButtonElement>('[data-search-term]').forEach((btn) => {
      btn.addEventListener('click', () => {
        input.value = btn.textContent?.trim() ?? '';
        search(input.value);
        input.focus();
      });
    });

    // Close on any result/link navigation inside the modal (links still navigate).
    modal.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
  }
</script>
