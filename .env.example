# Copy to .env and fill in. All PUBLIC_* vars are inlined into the client bundle.

# Cloudflare Web Analytics token. Get one from:
#   Cloudflare dashboard → Analytics & Logs → Web Analytics → Add a site → Manual setup.
# Leaving blank disables analytics in dev/prod.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Giscus (GitHub Discussions comments). Get IDs from https://giscus.app
# Repo: MLSysDev/mlsystems.dev, Category: Comments, Mapping: pathname.
# Leaving these blank shows the "comments not configured" fallback.
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY_ID=
